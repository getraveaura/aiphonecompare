---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import PostHog from '../components/PostHog.astro';
const { title, description = "The independent, verified price comparison for AI receptionists, by industry. Every price sourced and dated; sponsored spots labeled.", jsonld, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const siteJsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'aiphonecompare',
      url: siteUrl,
      logo: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      email: 'timothy@aiphonecompare.com',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'aiphonecompare',
      url: siteUrl,
      publisher: { '@id': `${siteUrl}#organization` },
    },
  ],
};
const path = Astro.url.pathname;
const current = (href) => (path === href || path.startsWith(href) ? 'page' : undefined);
const links = [
  ['/industries/dental/', 'Dental'],
  ['/industries/legal/', 'Legal'],
  ['/industries/plumbing/', 'Plumbing'],
  ['/industries/medical/', 'Medical'],
  ['/stories/', 'Stories'],
  ['/cost/', 'Cost'],
  ['/cost/calculator/', 'Calculator'],
  ['/pricing/', 'Pricing'],
  ['/about/', 'How we rank'],
  ['/badge/', 'Badge'],
  ['/get-featured/', 'Get featured'],
];
---
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} | aiphonecompare</title>
  <meta name="description" content={description}/>
  {noindex && <meta name="robots" content="noindex"/>}
  <link rel="canonical" href={canonical}/>
  <link rel="alternate" type="application/rss+xml" title="Stories and price changes" href="/feed.xml"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <script is:inline>
    document.documentElement.classList.add('js');
  </script>
  <PostHog />
  <meta name="theme-color" content="#f3efe6"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>
  <script type="application/ld+json" set:html={JSON.stringify(siteJsonld)}/>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <Wordmark />
      <details class="nav-disclosure">
        <summary>Menu</summary>
        <nav class="nav-panel" aria-label="Main">
          {links.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
        </nav>
      </details>
      <script is:inline>
        (function () {
          var nav = document.currentScript.previousElementSibling;
          if (nav && window.matchMedia('(min-width: 861px)').matches) nav.open = true;
        })();
      </script>
    </div>
  </header>
  <main id="main"><slot/></main>
  <footer class="site-footer">
    <div class="wrap foot">
      <div>
        <Wordmark />
        <p>Independent directory for what an AI receptionist costs, and what actually happened when a small business turned one on. Sponsored placements are always labeled.</p>
      </div>
      <nav aria-label="Directory">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href="/ai-answering-service/">AI answering service</a>
        <a href="/small-business/">Small business</a>
        <a href="/call-recording-consent-by-state/">Call recording consent</a>
        <a href="/missed-call-calculator/">Missed-call calculator</a>
        <a href="/vendors/">Vendors</a>
        <a href="/price-changes/">Price changes</a>
        <a href="/match/">Match</a>
        <a href="/data/">Open dataset</a>
        <a href="/privacy/">Privacy</a>
        <a href="/accessibility/">Accessibility</a>
      </nav>
      <p class="fine">Data is taken from vendor sites and cited third-party comparisons; blank means we could not verify it. Vendor icons are saved copies of each site's own favicon.</p>
      <p class="fine listed-on"><span>Also listed on</span> <a href="https://www.toolpilot.ai/" rel="noopener"><img src="/directories/toolpilot-featured.png" alt="Featured on ToolPilot" width="109" height="24" loading="lazy" decoding="async"></a> <a href="https://dang.ai/" rel="noopener">Dang.ai</a></p>
    </div>
  </footer>
  <nav class="dock" aria-label="Shortcuts">
    <a class="btn btn-primary" href="/match/">Match me</a>
    <a class="btn btn-ghost" href="/vendors/">Compare</a>
  </nav>
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var nodes = document.querySelectorAll('.reveal');
      if (!nodes.length) return;
      if (!('IntersectionObserver' in window)) {
        nodes.forEach(function (node) { node.classList.add('is-in'); });
        return;
      }
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      nodes.forEach(function (node) { observer.observe(node); });
    })();
  </script>
</body>
</html>
