---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
const { title, description = "The independent, verified price comparison for AI receptionists, by industry. Every price sourced and dated; sponsored spots labeled.", jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const path = Astro.url.pathname;
const current = (href) => (path === href || path.startsWith(href) ? 'page' : undefined);
const links = [
  ['/industries/dental/', 'Dental'],
  ['/industries/legal/', 'Legal'],
  ['/industries/plumbing/', 'Plumbing'],
  ['/pricing/', 'Pricing'],
  ['/about/', 'How we rank'],
  ['/badge/', 'Badge'],
  ['/get-featured/', 'Get featured'],
];
---
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} | aiphonecompare</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <meta name="theme-color" content="#f3efe6"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <Wordmark />
      <details class="nav-disclosure">
        <summary>Menu</summary>
        <nav class="nav-panel" aria-label="Main">
          {links.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
        </nav>
      </details>
    </div>
  </header>
  <main id="main"><slot/></main>
  <footer class="site-footer">
    <div class="wrap foot">
      <div>
        <Wordmark />
        <p>Independent directory. Sponsored placements are always labeled.</p>
      </div>
      <nav aria-label="Directory">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href="/ai-answering-service/">AI answering service</a>
        <a href="/small-business/">Small business</a>
        <a href="/missed-call-calculator/">Missed-call calculator</a>
        <a href="/data/">Open dataset</a>
        <a href="/accessibility/">Accessibility</a>
      </nav>
      <p class="fine">Data is taken from vendor sites and cited third-party comparisons; blank means we could not verify it. Preview build.</p>
    </div>
  </footer>
</body>
</html>
