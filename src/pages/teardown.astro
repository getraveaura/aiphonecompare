---
// Old URL. The Competitor check-up moved to /competitor-check-up/.
// Kept so old links, emails and the Stripe return URL keep working (query string is carried over).
import { TEARDOWN } from '../lib/offers.mjs';
const target = new URL(TEARDOWN.path, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Competitor check-up has moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${TEARDOWN.path}`} />
    <script is:inline define:vars={{ path: TEARDOWN.path }}>
      location.replace(path + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>The Competitor check-up has moved to <a href={TEARDOWN.path}>{target}</a>.</p>
  </body>
</html>
