---
import PlainIntro from '../components/PlainIntro.astro';
import Base from '../layouts/Base.astro';
import VendorTable from '../components/VendorTable.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import data from '../data/vendors.json';
import { formatDate } from '../lib/stories.mjs';
import { latestChecked } from '../lib/schema.mjs';
import { marketAnswer } from '../lib/quotable.mjs';
import AuditCta from '../components/AuditCta.astro';
const v = [...data].sort((a, b) => (b.starting_price ? 1 : 0) - (a.starting_price ? 1 : 0) || a.name.localeCompare(b.name));
const latest = latestChecked(data);
const latestLabel = latest ? formatDate(latest) : '';
const title = 'AI receptionist pricing';
const description = `AI receptionist pricing: published starting prices for ${data.length} AI receptionists, with sources and last-checked dates.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: new URL('/pricing/', Astro.site).href,
  description,
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  ...(latest ? { dateModified: latest } : {}),
};
---
<Base title={title} description={description} jsonld={jsonld}>
  <header class="page-intro">
    <div class="wrap">
      <h1>{title}</h1>
      <QuickAnswer text={marketAnswer()} />
      {latest && (
        <p class="checked">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect width="22" height="22" rx="11" fill="#1f5f4a"/><path d="M6.2 11.2 9.3 14.3 15.8 7.8" fill="none" stroke="#f3efe6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Prices checked <time datetime={latest}>{latestLabel}</time>
        </p>
      )}
      <p class="lead">These are published starting prices only. Blank means the company only gives prices on request, or we couldn't confirm one. A starting price is often not your real bill. For how much an AI receptionist costs at your call volume, use the <a href="/cost/">AI receptionist cost</a> page.</p>
      <PlainIntro primary={['/cost/', 'See pricing and cost']} secondary={['/cost/calculator/', 'Open the calculator']} />
      <p class="index-link">Want the full record? The <a href="/price-index/">price index</a> lists each price with where and when we found it.</p>
    </div>
  </header>
  <div class="wrap stack">
    <AuditCta />
    <VendorTable vendors={v}/>
  </div>
</Base>
