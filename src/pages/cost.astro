---
import Base from '../layouts/Base.astro';
import models from '../data/cost-models.json';
import { formatUsd } from '../lib/cost.mjs';

const checkedLabel = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${models.checked}T00:00:00Z`));
function oneTime(plan) {
  if (plan.setupFee == null) return 'Not verified';
  if (plan.setupFee === 0) return 'No setup fee on the pricing page';
  return `${formatUsd(Math.round(plan.setupFee * 100))} one time`;
}
---
<Base title="What an AI receptionist will cost" description="Estimate a monthly bill from your call volume for providers that publish official allowances and overage rates. Missing prices stay unverified.">
  <header class="page-intro">
    <div class="wrap">
      <h1>What an AI receptionist will cost</h1>
      <p class="lead">Enter your own call volume. The rows below turn that into a monthly scenario only where the provider's pricing page publishes the unit, the allowance, and the overage. A starting price is not the same as this bill.</p>
    </div>
  </header>
  <div class="wrap stack">
    <form id="cost-form" class="calc-form cost-form">
      <div>
        <label for="calls">Calls per month</label>
        <input id="calls" name="calls" type="number" inputmode="numeric" min="0" step="1">
      </div>
      <div>
        <label for="duration">Average call length in minutes</label>
        <input id="duration" name="duration" type="number" inputmode="decimal" min="0" step="any" aria-describedby="duration-hint">
        <p id="duration-hint" class="hint">Used for minute-billed plans. Per-call plans ignore it. Partial minutes are not rounded up.</p>
      </div>
      <div>
        <label for="unique">Unique callers per month</label>
        <input id="unique" name="unique" type="number" inputmode="numeric" min="0" step="1" aria-describedby="unique-hint">
        <p id="unique-hint" class="hint">Goodcall bills one phone number once a month. Leave this blank if you don't know it. Calls are not converted into customers.</p>
      </div>
      <button class="btn btn-primary" type="submit">Update estimates</button>
    </form>
    <p id="cost-status" class="note" aria-live="polite">Enter calls and an average length. Estimates stay blank until those numbers are usable.</p>
    <p>These providers are the ones whose own sites, checked <time datetime={models.checked}>{checkedLabel}</time>, publish enough to do this math. The other vendors stay in the <a href="/pricing/">starting-price directory</a>. Nothing here is sorted by price, and nothing is marked cheapest. Taxes and add-ons that are not printed are not included. Worked examples for 50, 150, and 300 calls: <a href="/cost/dental/">dental</a>, <a href="/cost/legal/">legal</a>, <a href="/cost/home-services/">home services</a>, <a href="/cost/medical/">medical</a>. <a href="/cost/hidden-fees/">Hidden fees</a> lists the printed setup fees and the story catches. The <a href="/cost/calculator/?calls=150&minutes=3">calculator</a> picks one plan per vendor and keeps the inputs in the link.</p>
    <div class="cost-list">
      {models.providers.map((provider) => (
        <article class="cost-provider" aria-labelledby={`${provider.id}-heading`}>
          <h2 id={`${provider.id}-heading`}><a href={`/vendors/${provider.slug}/`}>{provider.name}</a></h2>
          <p>Checked <time datetime={models.checked}>{checkedLabel}</time>. Sources: {provider.sources.map((source, index) => <><a href={source.href} rel="nofollow noopener">{source.label}</a>{index < provider.sources.length - 1 ? ', ' : ''}</>)}.</p>
          <p><strong>Booking.</strong> {provider.booking}</p>
          <p><strong>Transfer.</strong> {provider.transfer}</p>
          <div class="tablewrap" tabindex="0">
            <table class="compare">
              <caption>{provider.name} plans. The published price is what the page lists. The scenario is your volume on that plan.</caption>
              <thead>
                <tr>
                  <th scope="col">Plan</th>
                  <th scope="col">Published price</th>
                  <th scope="col">Scenario this month</th>
                  <th scope="col">One-time</th>
                  <th scope="col">Formula</th>
                </tr>
              </thead>
              <tbody>
                {provider.plans.map((plan) => (
                  <tr>
                    <th scope="row">{plan.name}</th>
                    <td data-label="Published price">{plan.publishedLabel}</td>
                    <td data-label="Scenario this month" id={`${provider.id}-${plan.id}-scenario`}>Enter your numbers to estimate.</td>
                    <td data-label="One-time">{oneTime(plan)}</td>
                    <td data-label="Formula" id={`${provider.id}-${plan.id}-formula`}>The formula appears when the numbers are enough to calculate.</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul class="cost-notes">
            {provider.caveats.map((caveat) => <li>{caveat}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</Base>
<script>
  import models from '../data/cost-models.json';
  import { estimateAll, formatUsd } from '../lib/cost.mjs';
  const form = document.getElementById('cost-form');
  const status = document.getElementById('cost-status');
  function value(id) {
    const el = document.getElementById(id);
    return el ? el.value : '';
  }
  function scenarioText(plan) {
    if (plan.status === 'estimate') return `${formatUsd(plan.scenarioCents)} recurring this month`;
    if (plan.status === 'partial') return `Partial subtotal ${formatUsd(plan.scenarioCents)}. ${plan.reason}`;
    return `Cannot estimate. ${plan.reason}`;
  }
  function update() {
    const input = { calls: value('calls'), durationMinutes: value('duration'), uniqueCallers: value('unique') };
    const results = estimateAll(models.providers, input);
    let estimated = 0;
    let partial = 0;
    let blocked = 0;
    for (const provider of results) {
      for (const plan of provider.plans) {
        const scenario = document.getElementById(`${provider.id}-${plan.id}-scenario`);
        const formula = document.getElementById(`${provider.id}-${plan.id}-formula`);
        if (scenario) scenario.textContent = scenarioText(plan);
        if (formula) formula.textContent = plan.formula || plan.reason;
        if (plan.status === 'estimate') estimated += 1;
        else if (plan.status === 'partial') partial += 1;
        else blocked += 1;
      }
    }
    if (status) {
      status.textContent = `${estimated} rows have a monthly scenario, ${partial} are partial subtotals, and ${blocked} cannot be estimated. This is not a ranking.`;
    }
  }
  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      update();
    });
    form.addEventListener('input', update);
  }
</script>
