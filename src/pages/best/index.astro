---
import PlainIntro from '../../components/PlainIntro.astro';
import Base from '../../layouts/Base.astro';
import IndustryIcon from '../../components/IndustryIcon.astro';
import NextSteps from '../../components/NextSteps.astro';
import { getBestGuides } from '../../lib/best-guides.mjs';
import { accent } from '../../lib/industries.mjs';
import { articleNode, breadcrumbNode } from '../../lib/answers.mjs';
import { AUDIT_PATH, showAuditLinks } from '../../lib/audit.mjs';
import { getBudgets, getAlternatives, ALTERNATIVES_INDEX } from '../../lib/alternatives.mjs';
const budgets = getBudgets();
const alternatives = getAlternatives();
const guides = getBestGuides();
const listed = guides.filter((page) => page.count > 0);
const unlisted = guides.filter((page) => page.count === 0);
const title = 'Best AI receptionist by industry';
const description = 'Sourced AI receptionist guides by industry. These are not ranked lists. Where this site has no vendor directory, the page says so and points to the free check, the calculator, and done-for-you setup.';
const pageUrl = new URL('/best/', Astro.site).href;
const site = new URL('/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({ url: pageUrl, headline: title, description, site }),
    breadcrumbNode([['Home', site], [title, pageUrl]]),
    { '@type': 'ItemList', name: title, itemListElement: [...guides, ...budgets].map((page, i) => ({ '@type': 'ListItem', position: i + 1, name: page.h1, url: new URL(page.path, Astro.site).href })) },
  ],
};
---
<Base title={title} description={description} jsonld={jsonld}>
  <header class="page-intro">
    <div class="wrap">
      <h1>{title}</h1>
      <p class="lead">Pick your type of business to see which AI phone answering services fit, what they cost and what to test before you buy. We don't pick a winner, and no company can pay to rank higher. For a general shortlist, see <a href="/best/ai-phone-receptionists/">best AI phone receptionists for small businesses</a>.</p>
      <PlainIntro />
    </div>
  </header>
  <div class="wrap stack">
    <div class="industries">
      {listed.map((page) => (
        <a class="industry reveal" data-industry={page.industryKey || page.accent} href={page.path} style={`--accent:${accent(page.accent || page.industryKey)}`}>
          <IndustryIcon name={page.accent || page.industryKey} />
          <h2>{page.h1}</h2>
          <p>{page.count} sourced listing{page.count === 1 ? '' : 's'} · {page.kicker}</p>
          <span class="go">Open the guide <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
    {unlisted.length > 0 && (
      <>
        <h2 class="section-title">Industries without a dedicated directory yet</h2>
        <p>These pages do not invent a vendor list. They explain what this site does and does not have, and point to the free call coverage check, the cost calculator, and done-for-you setup.</p>
        <div class="industries">
          {unlisted.map((page) => (
            <a class="industry reveal" data-industry={page.accent || 'other'} href={page.path} style={`--accent:${accent(page.accent || 'other')}`}>
              <IndustryIcon name={page.accent || 'other'} />
              <h2>{page.h1}</h2>
              <p>No sourced listings yet · {page.kicker}</p>
              <span class="go">Open the guide <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </>
    )}
    <NextSteps
      title="Shop by budget"
      id="budget-title"
      trust="Sorted by the price each company prints on its own website. Rankings are not for sale."
      cards={budgets.map((b) => ({ href: b.path, title: `Under ${b.cap}`, text: `${b.count} with a published starting plan` }))}
      others={[...alternatives.map((p) => ({ href: p.path, label: `${p.target.vendor.name} alternatives` })), { href: ALTERNATIVES_INDEX, label: 'All alternatives' }]}
      othersLabel="Alternatives to"
    />
    <NextSteps
      title="Work out your cost"
      id="cost-help-title"
      trust=""
      cards={[
        { href: '/cost/hvac-shop/', title: 'Cost for a 3-tech HVAC shop', text: '50, 150 and 300 calls, same plans as home services' },
        { href: '/cost/calculator/?industry=plumbing&calls=150&minutes=3', title: 'Use my own numbers', text: 'Cost calculator with your call volume' },
        { href: '/cost/missed-call/', title: 'Cost of a missed call', text: 'Sourced figures, no invented averages' },
      ]}
    />
    {showAuditLinks() && <p class="good-to-know"><strong>Free:</strong> the <a href={AUDIT_PATH}>call coverage check</a> reviews your public website and listings, with no test call.</p>}
  </div>
</Base>
