---
import Base from '../layouts/Base.astro';
import data from '../data/vendors.json';
import { byPublishedMonthlyPrice, lowestMonthly } from '../lib/price.mjs';
import { latestChecked } from '../lib/schema.mjs';
import Faq from '../components/Faq.astro';
import AnswerSummary from '../components/AnswerSummary.astro';
import { articleNode, breadcrumbNode } from '../lib/answers.mjs';
import { formatDate } from '../lib/stories.mjs';
const cheapest = byPublishedMonthlyPrice(data)
  .filter((v) => lowestMonthly(v.starting_price) != null)
  .slice(0, 5)
  .map((v) => ({ ...v, monthly: lowestMonthly(v.starting_price) }));
const money = (n) => Number.isInteger(n) ? `$${n}` : `$${n}`;
const title = 'Missed-call cost calculator';
const pageTitle = 'Missed call revenue calculator for small business';
const low = cheapest.find((v) => v.monthly > 0);
const freeCount = cheapest.filter((v) => v.monthly === 0).length;
const summary = [
  'Monthly revenue lost to missed calls = calls per week × the share you miss × the share of those callers who would have become customers × your average job value, × 52 ÷ 12.',
  'This calculator uses only the four numbers you enter, with no industry averages, and also shows how many jobs a month would cover each of the lowest published AI receptionist prices.',
  low ? `The lowest paid monthly amount written in a listing here is ${money(low.monthly)}/mo, for ${low.name}${low.last_checked ? `, checked ${formatDate(low.last_checked)}` : ''}${freeCount ? `; ${freeCount} listing${freeCount === 1 ? '' : 's'} also show a $0 tier` : ''}.` : '',
].filter(Boolean);
const description = 'Work out monthly revenue lost to missed calls from your own four numbers, and how many jobs a month would pay for an AI receptionist at published prices.';
// dateModified is the latest checked date among the prices this page shows.
const latest = latestChecked(cheapest);
const pageUrl = new URL('/missed-call-calculator/', Astro.site).href;
const site = new URL('/', Astro.site).href;
const faqs = [
  { q: 'How do I calculate revenue lost to missed calls?', a: 'Multiply calls per week by the percent you miss, then by the percent of those callers who would have become customers, then by your average job value. That is a weekly figure. Multiply by 52 and divide by 12 for a month.' },
  { q: 'Does this calculator use industry averages?', a: 'No. It uses only the four numbers you enter. We do not add outside statistics on missed-call rates or conversion, because we could not source one that fits every business.' },
  { q: 'How many jobs would pay for an AI receptionist?', a: `Divide the plan's monthly price by your average job value. The table below does this for the lowest monthly amounts written in our listings${low ? `, from ${money(low.monthly)}/mo for ${low.name} among paid amounts` : ''}. A starting price is not your full bill: allowances, overage and setup fees can add to it.` },
  { q: 'Are these the best AI receptionists?', a: 'No. They are the listings with the lowest monthly dollar amount written in the published price. This is not a ranking of quality, and sponsorship does not change it.' },
];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: title,
      url: pageUrl,
      description,
      isPartOf: { '@id': `${site}#website` },
      ...(latest ? { dateModified: latest } : {}),
    },
    articleNode({ url: pageUrl, headline: pageTitle, description, modified: latest, citations: cheapest.map((v) => (v.sources || [])[0]).filter(Boolean), site }),
    breadcrumbNode([['Home', site], [title, pageUrl]]),
    { '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  ],
};
---
<Base title={pageTitle} description={description} jsonld={jsonld} modified={latest}>
  <header class="page-intro">
    <div class="wrap">
      <h1>Missed-call cost calculator</h1>
      <AnswerSummary sentences={summary} verified={latest} verifiedLabel="Prices last verified" sources={[{ href: '/price-index/', label: 'aiphonecompare price index' }]} />
      <p class="lead">This is an estimate from the four numbers you enter. It is not a forecast, and it does not use outside statistics.</p>
    </div>
  </header>
  <div class="wrap stack">
    <p>The monthly figure is your weekly result times 52 divided by 12, which spreads a year of weeks across 12 months. Vendor amounts are the lowest monthly dollar figure written in each listing, not a quote.</p>
    <div class="calc-grid">
      <form id="missed-call-form" class="calc-form">
        <div>
          <label for="calls">Calls per week</label>
          <input id="calls" name="calls" type="number" inputmode="decimal" min="0" step="any" required>
        </div>
        <div>
          <label for="missed">Percent of calls missed</label>
          <input id="missed" name="missed" type="number" inputmode="decimal" min="0" max="100" step="any" required>
        </div>
        <div>
          <label for="customers">Percent of missed calls that would become customers</label>
          <input id="customers" name="customers" type="number" inputmode="decimal" min="0" max="100" step="any" required>
        </div>
        <div>
          <label for="job">Average job value (USD)</label>
          <input id="job" name="job" type="number" inputmode="decimal" min="0" step="any" required>
        </div>
        <button class="btn btn-primary" type="submit">Calculate lost revenue</button>
      </form>
      <div id="estimate" class="estimate" aria-live="polite" aria-atomic="true">
        <h2>Your estimate</h2>
        <p>Enter all four numbers. The result uses only those inputs.</p>
      </div>
    </div>
    <section aria-labelledby="cheapest-heading">
      <h2 id="cheapest-heading" class="section-title">Cheapest verified monthly prices</h2>
      <p class="note">These are the five listings with the lowest monthly dollar amount written in the published price. Checked dates are on each vendor page. This is not a ranking of quality.</p>
      <div class="tablewrap" tabindex="0" aria-labelledby="cheapest-caption">
        <table class="compare">
          <caption id="cheapest-caption">Lowest monthly amounts written in verified listings.</caption>
          <thead>
            <tr>
              <th scope="col">Vendor</th>
              <th scope="col">Monthly amount in the listing</th>
              <th scope="col">Published price</th>
              <th scope="col">Checked</th>
              <th scope="col">Jobs a month to cover it</th>
            </tr>
          </thead>
          <tbody>
            {cheapest.map((v) => (
              <tr>
                <th scope="row"><a href={`/vendors/${v.slug}/`}>{v.name}</a></th>
                <td data-label="Monthly amount in the listing">{money(v.monthly)}/mo</td>
                <td data-label="Published price">{v.starting_price}</td>
                <td data-label="Checked">{v.last_checked ? <time datetime={v.last_checked}>{v.last_checked}</time> : <span class="missing">Not verified</span>}</td>
                <td data-label="Jobs a month to cover it" data-breakeven={v.monthly}><span class="missing">Enter a job value</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <section aria-labelledby="method-heading" class="prose">
      <h2 id="method-heading" class="section-title">How the math works</h2>
      <p>Weekly lost revenue = calls per week × (percent missed ÷ 100) × (percent who would become customers ÷ 100) × average job value. Monthly = weekly × 52 ÷ 12. Jobs a month to cover a plan = the plan's monthly amount ÷ your average job value, rounded up to a whole job.</p>
      <p>Related: <a href="/cost/calculator/">AI receptionist cost calculator</a> for your call volume, <a href="/worth-it/">is an AI receptionist worth it?</a> from sourced stories, the <a href="/price-index/">price index</a>, and <a href="/small-business/">AI receptionists for small business</a>.</p>
    </section>
    <Faq items={faqs}/>
  </div>
</Base>
<script is:inline>
(function () {
  var form = document.getElementById('missed-call-form');
  var out = document.getElementById('estimate');
  if (!form || !out) return;
  var money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
  function num(id) {
    var el = document.getElementById(id);
    if (!el || el.value.trim() === '') return null;
    var n = Number(el.value);
    return Number.isFinite(n) ? n : NaN;
  }
  function show(html) { out.innerHTML = html; }
  function calculate() {
    var calls = num('calls');
    var missed = num('missed');
    var customers = num('customers');
    var job = num('job');
    if (calls === null || missed === null || customers === null || job === null) {
      show('<h2>Your estimate</h2><p>Enter all four numbers. The result uses only those inputs.</p>');
      return;
    }
    if ([calls, missed, customers, job].some(function (n) { return Number.isNaN(n) || n < 0; }) || missed > 100 || customers > 100) {
      show('<h2>Your estimate</h2><p>Use numbers that are zero or greater. Both percents must be from 0 to 100.</p>');
      return;
    }
    var missedCalls = calls * (missed / 100);
    var lostCustomers = missedCalls * (customers / 100);
    var perWeek = lostCustomers * job;
    var perMonth = perWeek * 52 / 12;
    show(
      '<h2>Your estimate</h2>' +
      '<p><strong>' + money.format(perMonth) + '</strong> of revenue per month, from the numbers you entered. This is not a forecast.</p>' +
      '<p>' + calls + ' calls a week × ' + missed + '% missed × ' + customers + '% that would become customers × ' + money.format(job) + ' = ' + money.format(perWeek) + ' per week. Per month is that weekly amount × 52 ÷ 12.</p>'
    );
  }
  function breakeven() {
    var job = num('job');
    document.querySelectorAll('[data-breakeven]').forEach(function (cell) {
      var monthly = Number(cell.getAttribute('data-breakeven'));
      if (job === null || Number.isNaN(job) || job <= 0 || !Number.isFinite(monthly)) {
        cell.innerHTML = '<span class="missing">Enter a job value</span>';
        return;
      }
      if (monthly === 0) { cell.textContent = '$0 tier'; return; }
      var jobs = Math.ceil(monthly / job);
      cell.textContent = jobs + (jobs === 1 ? ' job' : ' jobs');
    });
  }
  form.addEventListener('input', breakeven);
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    calculate();
  });
  form.addEventListener('input', calculate);
})();
</script>
