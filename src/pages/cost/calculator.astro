---
import Base from '../../layouts/Base.astro';
import models from '../../data/cost-models.json';
import vendors from '../../data/vendors.json';
import { DEFAULT_INPUT, INDUSTRY_OPTIONS, quoteDirectory, quoteSummary, shownBill } from '../../lib/calculator.mjs';
import { formatDate } from '../../lib/stories.mjs';
import { outboundLink, REFERRAL_NOTE } from '../../lib/outbound.mjs';
import { hostLabel, shortDay } from '../../lib/source-label.mjs';
import SetupNextStep from '../../components/SetupNextStep.astro';
const quote = quoteDirectory(vendors, models, DEFAULT_INPUT);
const description = 'Calculate your monthly and first-year AI receptionist bill from published plans. If a company does not publish a fee, we say so instead of guessing. For AI receptionist pricing and cost, start on the cost page.';
const pageUrl = new URL('/cost/calculator/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: 'Calculate your monthly AI receptionist bill', description, url: pageUrl, isPartOf: { '@id': new URL('/#website', Astro.site).href }, ...(quote.checked ? { dateModified: quote.checked } : {}) },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Cost', item: new URL('/cost/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: 'Calculator', item: pageUrl },
      ],
    },
  ],
};
---
<Base title="Calculate your monthly AI receptionist bill" description={description} jsonld={jsonld} ogImage="/og/cost.png">
  <header class="page-intro guide-read">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/cost/">Cost</a></li>
          <li><span aria-current="page">Calculator</span></li>
        </ol>
      </nav>
      <h1>Calculate your monthly AI receptionist bill</h1>
      <p class="lead">Use this calculator to see a monthly and first-year bill from published plans. The table starts at 150 calls a month, 3 minutes each. For the AI receptionist pricing guide, start on the <a href="/cost/">cost page</a>. Ruby's row is a live receptionist plan, not an AI plan. Bland AI and ElevenLabs are platforms you build. Jobber is an add-on.</p>
      <ul class="trust-chips"><li>Free, no sign-up</li><li>Real prices from each company</li><li>Rankings not for sale</li></ul>
      <p class="tool-line">Already paying for one? <a id="overpaying-link" href="/overpaying/">Compare what you pay with these plans</a>.</p>
      <p class="tool-line">Thinking about a live receptionist instead? See <a href="/cost/ai-vs-live-receptionist/">what live and AI cost at 50, 150 and 300 calls</a>.</p>
    </div>
  </header>
  <div class="wrap stack">
    <form id="calc-form" class="calc-form cost-form">
      <div>
        <label for="industry">Industry</label>
        <select id="industry" name="industry">
          {INDUSTRY_OPTIONS.map(([id, label]) => <option value={id} selected={id === quote.input.industry}>{label}</option>)}
        </select>
      </div>
      <div>
        <label for="calls">Calls per month</label>
        <input id="calls" name="calls" type="number" inputmode="numeric" min="0" step="1" value={quote.input.calls}>
      </div>
      <div>
        <label for="minutes">Average call length in minutes</label>
        <input id="minutes" name="minutes" type="number" inputmode="decimal" min="0" step="any" value={quote.input.minutes} aria-describedby="minutes-hint">
        <p id="minutes-hint" class="hint">Only matters for plans that charge by the minute.</p>
      </div>
      <div>
        <label for="after">After-hours share, percent, optional</label>
        <input id="after" name="after" type="number" inputmode="numeric" min="0" max="100" step="1" aria-describedby="after-hint">
        <p id="after-hint" class="hint">Optional. Leave blank if you don't know. No company here charges extra for after-hours calls on its price page, so it doesn't change the total.</p>
      </div>
      <div class="cta">
        <button class="btn btn-primary" type="button" id="calc-update">Update estimates</button>
        <button class="btn btn-ghost" type="button" id="copy-link">Copy link</button>
      </div>
      <p id="copy-status" class="note" role="status" aria-live="polite"></p>
    </form>
    <noscript>
      <p>JavaScript is off, so this table stays on the default: all industries, 150 calls, 3 minutes. The buttons do not change it.</p>
    </noscript>
    <p id="calc-summary">{quoteSummary(quote)}</p>
    <p class="note referral-note">{REFERRAL_NOTE} A Visit link sits on the same line as OnCrew, NextPhone, or Rosie when that vendor is in the table.</p>
    <h2 class="section-title">Assumptions</h2>
    <ul id="assumptions">
      {quote.assumptions.map((item) => <li>{item}</li>)}
    </ul>
    <div class="tablewrap" tabindex="0">
      <table class="compare calc-results">
        <caption>Vendors with a complete monthly estimate. Where the calls do not fit inside a printed plan, the monthly figure is our calculation from the printed plan price, included use, and printed extra-use rate. The highlighted row is the lowest first-year total among plans that also publish a setup fee. Each source shows that row's check date.</caption>
        <thead>
          <tr>
            <th scope="col">Vendor</th>
            <th scope="col">Plan</th>
            <th scope="col">Monthly</th>
            <th scope="col">First year</th>
            <th scope="col">Setup</th>
            <th scope="col">Notes</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody id="priced-body">
          {quote.priced.map((row) => (
            <tr class:list={{ 'is-lowest': row.lowest }}>
              <th scope="row" data-label="Vendor">
                <span class="vendor-name"><a href={`/vendors/${row.slug}/`}>{row.name}</a>{outboundLink(vendors.find((v) => v.slug === row.slug))?.isReferral && <a class="visit-line" href={outboundLink(vendors.find((v) => v.slug === row.slug)).href} rel={outboundLink(vendors.find((v) => v.slug === row.slug)).rel} data-vendor-slug={row.slug} data-vendor-referral="1" title={`Visit ${row.name}. ${REFERRAL_NOTE}`}>Visit</a>}</span>
                {row.kindLabel && <span class="kind-pill" title={row.kindLabel}>{row.kindLabel}</span>}
                {row.lowest && <span class="lowest-flag"> Lowest first-year total</span>}
                {row.sponsored && <span class="badge">Sponsored</span>}
              </th>
              <td data-label="Plan">{row.planName}</td>
              <td data-label="Monthly">{row.monthly === 'Not enough public pricing' ? <span title="Not enough public pricing">Not public</span> : shownBill(row.monthly, row.worked)}</td>
              <td data-label="First year">{row.year === 'Not enough public pricing' ? <span title="Not enough public pricing">Not public</span> : row.year}</td>
              <td data-label="Setup">{row.setup === 'No setup fee on the pricing page' ? <span title="No setup fee on the pricing page">None listed</span> : row.setup}</td>
              <td data-label="Notes">
                {row.unknowns.length || row.reason ? (
                  <details class="row-notes">
                    <summary>
                      <span class="note-summary">{row.unknowns[0] || row.reason}</span>
                      <span class="note-toggle">Details</span>
                    </summary>
                    {row.unknowns.length > 0 && <ul>{row.unknowns.map((item) => <li>{item}</li>)}</ul>}
                    {row.reason && <p>{row.reason}</p>}
                  </details>
                ) : 'None stated on the pricing page'}
              </td>
              <td class="src-cell" data-label="Source">
                {row.sourceHref
                  ? <a class="src-compact" href={row.sourceHref} rel="nofollow noopener"><span>{hostLabel(row.sourceHref)}</span>{row.checked && <time datetime={row.checked}>{shortDay(row.checked)}</time>}</a>
                  : row.sourceLabel}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tool-line">Comparing with a live receptionist? <a href="/cost/ai-vs-live-receptionist/">See the full AI vs live receptionist cost breakdown</a>.</p>
    <h2 class="section-title">Not enough public pricing</h2>
    <div class="tablewrap" tabindex="0">
      <table class="compare">
        <caption>These vendors are in the selected industry, and the published record is not enough to price this call count.</caption>
        <thead>
          <tr>
            <th scope="col">Vendor</th>
            <th scope="col">Why</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody id="missing-body">
          {quote.missing.map((row) => (
            <tr>
              <th scope="row" data-label="Vendor">
                <span class="vendor-name"><a href={`/vendors/${row.slug}/`}>{row.name}</a>{outboundLink(vendors.find((v) => v.slug === row.slug))?.isReferral && <a class="visit-line" href={outboundLink(vendors.find((v) => v.slug === row.slug)).href} rel={outboundLink(vendors.find((v) => v.slug === row.slug)).rel} data-vendor-slug={row.slug} data-vendor-referral="1" title={`Visit ${row.name}. ${REFERRAL_NOTE}`}>Visit</a>}</span>
                {row.sponsored && <span class="badge">Sponsored</span>}
              </th>
              <td data-label="Why">{row.reason}</td>
              <td class="src-cell" data-label="Source">
                {row.sourceHref
                  ? <a class="src-compact" href={row.sourceHref} rel="nofollow noopener"><span>{hostLabel(row.sourceHref)}</span>{row.checked && <time datetime={row.checked}>{shortDay(row.checked)}</time>}</a>
                  : 'No source URL'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>Sourced figures about missed calls, with no typical cost invented, are on <a href="/cost/missed-call/">cost of a missed call</a>.</p>
    <SetupNextStep source="cost_calculator" />
    <p>Plan-by-plan formulas, without picking one plan per vendor, are on the <a href="/cost/">cost method</a>.</p>
  </div>
</Base>
<script>
  import models from '../../data/cost-models.json';
  import vendors from '../../data/vendors.json';
  import { calculatorPath, parseCalculatorQuery, quoteDirectory, quoteSummary, shownBill } from '../../lib/calculator.mjs';
  import { overpayingPath } from '../../lib/overpaying.mjs';
  import { track } from '../../lib/analytics.mjs';
  import { outboundLink, REFERRAL_NOTE } from '../../lib/outbound.mjs';
  import { hostLabel, shortDay } from '../../lib/source-label.mjs';

  const form = document.getElementById('calc-form');
  const summary = document.getElementById('calc-summary');
  const assumptions = document.getElementById('assumptions');
  const pricedBody = document.getElementById('priced-body');
  const missingBody = document.getElementById('missing-body');
  const copyStatus = document.getElementById('copy-status');

  function readForm() {
    return parseCalculatorQuery({
      industry: document.getElementById('industry').value,
      calls: document.getElementById('calls').value,
      minutes: document.getElementById('minutes').value,
      after: document.getElementById('after').value,
    });
  }

  function setupCell(row) {
    const cell = document.createElement('td');
    cell.setAttribute('data-label', 'Setup');
    if (row.setup === 'No setup fee on the pricing page') {
      const short = document.createElement('span');
      short.title = row.setup;
      short.textContent = 'None listed';
      cell.append(short);
    } else {
      cell.textContent = row.setup;
    }
    return cell;
  }

  function textCell(tag, label, text) {
    const cell = document.createElement(tag);
    cell.setAttribute('data-label', label);
    if (text === 'Not enough public pricing') {
      const short = document.createElement('span');
      short.title = text;
      short.textContent = 'Not public';
      cell.append(short);
    } else {
      cell.textContent = text;
    }
    return cell;
  }

  function sourceCell(row) {
    const cell = document.createElement('td');
    cell.className = 'src-cell';
    cell.setAttribute('data-label', 'Source');
    if (row.sourceHref) {
      const link = document.createElement('a');
      link.className = 'src-compact';
      link.href = row.sourceHref;
      link.rel = 'nofollow noopener';
      const host = document.createElement('span');
      host.textContent = hostLabel(row.sourceHref);
      link.append(host);
      if (row.checked) {
        const time = document.createElement('time');
        time.dateTime = row.checked;
        time.textContent = shortDay(row.checked);
        link.append(time);
      }
      cell.append(link);
    } else {
      cell.textContent = row.sourceLabel || 'No source URL';
    }
    return cell;
  }

  function vendorCell(row) {
    const cell = document.createElement('th');
    cell.scope = 'row';
    cell.setAttribute('data-label', 'Vendor');
    const nameLine = document.createElement('span');
    nameLine.className = 'vendor-name';
    const link = document.createElement('a');
    link.href = `/vendors/${row.slug}/`;
    link.textContent = row.name;
    nameLine.append(link);
    const vendor = vendors.find((item) => item.slug === row.slug);
    const visit = outboundLink(vendor);
    if (visit?.isReferral) {
      const go = document.createElement('a');
      go.className = 'visit-line';
      go.href = visit.href;
      go.rel = visit.rel;
      go.dataset.vendorSlug = row.slug;
      go.dataset.vendorReferral = '1';
      go.title = `Visit ${row.name}. ${REFERRAL_NOTE}`;
      go.textContent = 'Visit';
      nameLine.append(go);
    }
    cell.append(nameLine);
    if (row.kindLabel) {
      const kind = document.createElement('span');
      kind.className = 'kind-pill';
      kind.title = row.kindLabel;
      kind.textContent = row.kindLabel;
      cell.append(kind);
    }
    if (row.lowest) {
      const flag = document.createElement('span');
      flag.className = 'lowest-flag';
      flag.textContent = ' Lowest first-year total';
      cell.append(flag);
    }
    if (row.sponsored) {
      const badge = document.createElement('span');
      badge.className = 'badge';
      badge.textContent = 'Sponsored';
      cell.append(badge);
    }
    return cell;
  }

  function paint(quote) {
    summary.textContent = quoteSummary(quote);
    assumptions.replaceChildren();
    for (const item of quote.assumptions) {
      const li = document.createElement('li');
      li.textContent = item;
      assumptions.append(li);
    }
    pricedBody.replaceChildren();
    for (const row of quote.priced) {
      const tr = document.createElement('tr');
      if (row.lowest) tr.className = 'is-lowest';
      tr.append(
        vendorCell(row),
        textCell('td', 'Plan', row.planName),
        textCell('td', 'Monthly', shownBill(row.monthly, row.worked)),
        textCell('td', 'First year', row.year),
        setupCell(row),
      );
      const unknowns = document.createElement('td');
      unknowns.setAttribute('data-label', 'Notes');
      if (row.unknowns.length || row.reason) {
        const details = document.createElement('details');
        details.className = 'row-notes';
        const summaryEl = document.createElement('summary');
        const preview = document.createElement('span');
        preview.className = 'note-summary';
        preview.textContent = row.unknowns[0] || row.reason;
        const toggle = document.createElement('span');
        toggle.className = 'note-toggle';
        toggle.textContent = 'Details';
        summaryEl.append(preview, toggle);
        details.append(summaryEl);
        if (row.unknowns.length) {
          const list = document.createElement('ul');
          for (const item of row.unknowns) {
            const li = document.createElement('li');
            li.textContent = item;
            list.append(li);
          }
          details.append(list);
        }
        if (row.reason) {
          const note = document.createElement('p');
          note.textContent = row.reason;
          details.append(note);
        }
        unknowns.append(details);
      } else {
        unknowns.textContent = 'None stated on the pricing page';
      }
      tr.append(unknowns, sourceCell(row));
      pricedBody.append(tr);
    }
    missingBody.replaceChildren();
    for (const row of quote.missing) {
      const tr = document.createElement('tr');
      const why = textCell('td', 'Why', row.reason);
      tr.append(vendorCell(row), why, sourceCell(row));
      missingBody.append(tr);
    }
    const path = calculatorPath(quote.input);
    const check = document.getElementById('overpaying-link');
    if (check) check.href = overpayingPath({ ...quote.input, cost: null });
    if (`${location.pathname}${location.search}` !== path) history.replaceState(null, '', path);
  }

  let lastTracked = '';

  function trackUse(quote) {
    const key = calculatorPath(quote.input);
    if (key === lastTracked) return;
    lastTracked = key;
    track('tool_used', {
      tool: 'cost_calculator',
      industry: quote.input.industry,
      calls: quote.input.calls,
      minutes: quote.input.minutes,
    });
  }

  function update(fromUser = false) {
    const quote = quoteDirectory(vendors, models, readForm());
    paint(quote);
    if (fromUser) trackUse(quote);
  }

  const params = Object.fromEntries(new URLSearchParams(location.search));
  if (location.search) {
    const parsed = parseCalculatorQuery(params);
    document.getElementById('industry').value = parsed.industry;
    document.getElementById('calls').value = String(parsed.calls);
    document.getElementById('minutes').value = String(parsed.minutes);
    document.getElementById('after').value = parsed.afterHours == null ? '' : String(parsed.afterHours);
    update(false);
  }

  form.addEventListener('input', () => update(true));
  document.getElementById('calc-update').addEventListener('click', () => update(true));
  document.getElementById('copy-link').addEventListener('click', async () => {
    const url = `${location.origin}${calculatorPath(readForm())}`;
    copyStatus.textContent = url;
    try {
      await navigator.clipboard.writeText(url);
      copyStatus.textContent = 'Link copied.';
    } catch (error) {
      copyStatus.textContent = url;
    }
  });
</script>
