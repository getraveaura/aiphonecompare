---
import Base from '../../layouts/Base.astro';
import VendorMark from '../../components/VendorMark.astro';
import VerifyStrip from '../../components/VerifyStrip.astro';
import StoryCards from '../../components/StoryCards.astro';
import Catches from '../../components/Catches.astro';
import Checklist from '../../components/Checklist.astro';
import AnswerSummary from '../../components/AnswerSummary.astro';
import models from '../../data/cost-models.json';
import data from '../../data/vendors.json';
import stories from '../../data/stories.json';
import priceLog from '../../data/price-changes.json';
import { catchGroups, formatDate, storiesForVendor } from '../../lib/stories.mjs';
import { linksForVendor } from '../../lib/landings.mjs';
import { vendorOffer } from '../../lib/schema.mjs';
import { outboundLink, REFERRAL_NOTE } from '../../lib/outbound.mjs';
import { vendorSummary, sourceLinks, articleNode, productNode, breadcrumbNode } from '../../lib/answers.mjs';
export function getStaticPaths(){ return data.map((v) => ({ params: { slug: v.slug }, props: { v } })); }
const { v } = Astro.props;
const industryLabel = { dental: 'Dental', legal: 'Legal', plumbing: 'Plumbing', medical: 'Medical' };
const industryHref = { dental: '/industries/dental/', legal: '/industries/legal/', plumbing: '/industries/plumbing/', medical: '/industries/medical/' };
const formatCheck = (d) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`));
const checkedLabel = v.last_checked
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${v.last_checked}T00:00:00Z`))
  : '';
const facts = [
  ['Starting price', v.starting_price],
  ['HIPAA / BAA', v.hipaa_baa],
  ['Integrations', v.integrations],
];
const details = [
  ['Billing model', v.billing_model],
  ['Free trial', v.free_trial],
  ['Human handoff', v.human_handoff],
  ['Industries', v.industries.map((k) => industryLabel[k] || k).join(', ')],
  ['Notes', v.notes],
];
if (!v.website) details.unshift(['Website', '']);
const relatedStories = storiesForVendor(stories, v.slug);
const vendorCatches = relatedStories.flatMap((story) => story.catches || []);
const catchSet = catchGroups(stories, { vendorSlug: v.slug });
const priceChanges = priceLog.changes.filter((change) => change.vendorSlug === v.slug);
const guides = linksForVendor(v.slug);
const summary = vendorSummary(v, priceLog.changes);
const summarySources = sourceLinks(v.sources, 3);
const description = `${summary[0]} Features, integrations and sources. Last checked ${v.last_checked}.`.slice(0, 300);
const outbound = outboundLink(v);
const offer = vendorOffer(v);
const vendorOrg = { '@type': 'Organization', name: v.name };
if (v.website) vendorOrg.url = v.website;
if (offer) vendorOrg.makesOffer = offer;
const pageUrl = new URL(`/vendors/${v.slug}/`, Astro.site).href;
const site = new URL('/', Astro.site).href;
const webPage = {
  '@type': 'WebPage',
  name: v.name,
  url: pageUrl,
  description,
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  about: vendorOrg,
};
if (v.last_checked) webPage.dateModified = v.last_checked;
const provider = models.providers.find((p) => p.slug === v.slug);
const product = productNode({ vendor: v, provider, checked: models.checked, url: pageUrl });
const pageYear = (v.last_checked || models.checked || '').slice(0, 4);
const pageTitle = `${v.name} pricing & review${pageYear ? ` (${pageYear})` : ''}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    webPage,
    articleNode({ url: pageUrl, headline: pageTitle, description, modified: v.last_checked, citations: v.sources, site }),
    breadcrumbNode([['Home', site], ['Vendors', new URL('/vendors/', Astro.site).href], [v.name, pageUrl]]),
    ...(product ? [product] : []),
  ],
};

---
<Base title={pageTitle} description={description} jsonld={jsonld} modified={v.last_checked}>
  <header class="page-intro">
    <div class="wrap">
      <VerifyStrip />
      <h1 class="with-mark"><VendorMark slug={v.slug} name={v.name} />{v.name}</h1>
      {v.sponsored && <p><span class="badge">Sponsored</span></p>}
      <AnswerSummary sentences={summary} verified={v.last_checked} sources={summarySources} />
      {outbound && <p class="lead" style="margin-top:14px"><a href={outbound.href} rel={outbound.rel}>{v.website || outbound.href}</a></p>}
      {outbound?.isReferral && <p class="note referral-note">{REFERRAL_NOTE}</p>}
    </div>
  </header>
  <div class="wrap stack">
    <div class="facts">
      {facts.map(([label, val]) => (
        <section class="fact">
          <h2>{label}</h2>
          <p>{val || <span class="missing">Not verified</span>}</p>
        </section>
      ))}
    </div>
    <dl class="record">
      {details.map(([label, val]) => (
        <div>
          <dt>{label}</dt>
          <dd>
            {label === 'Industries'
              ? v.industries.map((k, i) => <>{i ? ', ' : ''}{industryHref[k] ? <a href={industryHref[k]}>{industryLabel[k] || k}</a> : (industryLabel[k] || k)}</>)
              : (val || <span class="missing">Not verified</span>)}
          </dd>
        </div>
      ))}
    </dl>
    <p>All published starting prices are on <a href="/pricing/">the pricing page</a>. Phone-recording statutes are on <a href="/call-recording-consent-by-state/">call recording consent by state</a>.</p>
    {guides.length > 0 && (
      <p>
        Related guides:
        {guides.map((guide, index) => <>{index ? ', ' : ''}<a href={guide.href}>{guide.label}</a></>)}.
      </p>
    )}
    <section aria-labelledby="price-changes-heading">
      <h2 id="price-changes-heading" class="section-title">Price changes</h2>
      {priceChanges.length ? priceChanges.map((change) => (
        <p>
          <a href={`/price-changes/${change.id}/`}>Logged {formatDate(change.observed)}</a>. {change.summary}
        </p>
      )) : (
        <p>No price change is logged for {v.name}. Tracking started <time datetime={priceLog.trackingStarted}>{formatDate(priceLog.trackingStarted)}</time>. <a href="/price-changes/">Price change log</a>.</p>
      )}
    </section>
    {relatedStories.length > 0 && (
      <section aria-labelledby="real-stories">
        <h2 id="real-stories" class="section-title">Real stories</h2>
        <StoryCards stories={relatedStories} />
      </section>
    )}
    <Catches groups={catchSet} />
    <Checklist catches={vendorCatches} />
    <section>
      <h2 class="section-title">Sources</h2>
      <ul class="sources">{v.sources.map((s) => <li><a href={s} rel="nofollow noopener">{s}</a></li>)}</ul>
      {v.price_check && (
        <p class="note">{v.price_check.result === 'not-confirmed' ? 'Not confirmed on the vendor’s site' : 'Price check'}, <time datetime={v.price_check.date}>{formatCheck(v.price_check.date)}</time>: {v.price_check.note}</p>
      )}
      <p class="note">Prices change; confirm on the vendor's site.</p>
    </section>
  </div>
</Base>
