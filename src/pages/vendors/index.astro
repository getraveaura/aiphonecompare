---
import GridCta from '../../components/GridCta.astro';
import { offlineLabel } from '../../lib/site-status.mjs';
import PlainIntro from '../../components/PlainIntro.astro';
import Base from '../../layouts/Base.astro';
import VendorMark from '../../components/VendorMark.astro';
import data from '../../data/vendors.json';
import { latestChecked } from '../../lib/schema.mjs';
import { isSponsored } from '../../lib/spotlight.mjs';
import AuditCta from '../../components/AuditCta.astro';
import PricePlans from '../../components/PricePlans.astro';
const vendors = [...data].sort((a, b) => a.name.localeCompare(b.name));
const description = 'Directory of the AI receptionist vendors we track. Starting prices are sourced. Sponsored spots are labeled.';
const latest = latestChecked(vendors);
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'AI receptionist vendors',
      url: new URL('/vendors/', Astro.site).href,
      description,
      isPartOf: { '@id': new URL('/#website', Astro.site).href },
      ...(latest ? { dateModified: latest } : {}),
    },
    {
      '@type': 'ItemList',
      name: 'AI receptionist vendors',
      ...(latest ? { dateModified: latest } : {}),
      itemListElement: vendors.map((vendor, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: vendor.name,
        url: new URL(`/vendors/${vendor.slug}/`, Astro.site).href,
      })),
    },
  ],
};
---
<Base title="AI receptionist vendors" description={description} jsonld={jsonld}>
  <header class="page-intro">
    <div class="wrap">
      <h1>Every AI phone answering service we compare</h1>
      <p class="lead">This is the full list of AI receptionists (AI phone answering services) we track, A to Z. Each starting price links to where we found it. Ads are labeled Sponsored. For a shortlist by situation, see <a href="/best/ai-phone-receptionists/">best AI phone receptionists</a>. For a monthly bill, see <a href="/cost/">what it costs</a>.</p>
      <PlainIntro />
    </div>
  </header>
  <div class="wrap stack">
    <p class="price-cards-caption" id="vendor-index-caption">A to Z, not a ranking. Sponsored spots are labeled. "Not verified" means no starting price was sourced. Open any card for the source and the date we checked. Also available as an <a href="/data/">open dataset</a>.</p>
    <ul class="price-cards vendor-index balanced" role="list" aria-labelledby="vendor-index-caption">
      {vendors.map((vendor) => (
        <li class="price-card" id={vendor.slug}>
          <div class="price-card-head">
            <VendorMark slug={vendor.slug} name={vendor.name} />
            <h2><a href={`/vendors/${vendor.slug}/`}>{vendor.name}</a></h2>
            {isSponsored(vendor) && <span class="badge">Sponsored</span>}
            {offlineLabel(vendor) && <span class="badge badge-warn">{offlineLabel(vendor)}</span>}
          </div>
          <PricePlans vendor={vendor} meta tags size="sm" max={3} />
          <p class="price-card-more"><a href={`/vendors/${vendor.slug}/`}>See details<span class="vh"> for {vendor.name}</span><span class="arrow" aria-hidden="true"> →</span></a></p>
        </li>
      ))}
      <GridCta count={vendors.length} href="/match/" title="Find my best match" text="Not sure which one? Pick your industry, call volume and must-haves." />
    </ul>
    <AuditCta />
  </div>
</Base>
