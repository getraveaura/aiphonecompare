---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import VendorTable from '../components/VendorTable.astro';
import data from '../data/vendors.json';
import { byPublishedMonthlyPrice, lowestMonthly, lowestMonthlyListing } from '../lib/price.mjs';
import { formatDate } from '../lib/stories.mjs';
import { latestChecked } from '../lib/schema.mjs';
const vendors = byPublishedMonthlyPrice(data);
const low = lowestMonthlyListing(data);
const lowAmount = low ? lowestMonthly(low.starting_price) : null;
const lowText = lowAmount == null ? null : (Number.isInteger(lowAmount) ? `$${lowAmount}` : `$${lowAmount}`);
const checked = low?.last_checked
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${low.last_checked}T00:00:00Z`))
  : '';
const priceAnswer = low
  ? `The lowest monthly amount written in a listing is ${lowText}/mo, for ${low.name}.${checked ? ` That figure was checked on ${checked}.` : ''} Where no monthly amount is published, the table says Not verified.`
  : 'No listing currently publishes a monthly starting price. Those rows say Not verified.';
const faqs = [
  { q: 'What is an AI answering service?', a: 'An AI answering service uses software to answer inbound phone calls. It can take a message and, on some products, book or transfer the call. A person is not on the line for that first answer.' },
  { q: 'How much does an AI answering service cost?', a: priceAnswer },
  { q: 'Do you rank these services?', a: 'No. The table sorts by the lowest monthly dollar amount written in each listing. That is not a quality score. Sponsored listings are labeled, and payment does not change the price text.' },
  { q: 'Where are prices checked?', a: 'Each price is copied from the vendor site or from a cited source, and the vendor page shows the date we checked it. A blank price means we have not verified one.' },
];
const latest = latestChecked(data);
const latestLabel = latest ? formatDate(latest) : '';
const title = 'AI answering service comparison';
const description = 'Compare AI answering services by the monthly starting price published in each listing. Prices we could not verify are marked Not verified.';
const pageUrl = new URL('/ai-answering-service/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: title, url: pageUrl, description, isPartOf: { '@id': new URL('/#website', Astro.site).href }, ...(latest ? { dateModified: latest } : {}) },
    { '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  ],
};
const caption = 'Sorted by the lowest monthly dollar amount written in each listing. Per-minute rates are not converted into a monthly price. Not verified means no starting price was published. This is not a quality ranking.';
---
<Base title={title} description={description} jsonld={jsonld}>
  <header class="page-intro">
    <div class="wrap">
      <h1>{title}</h1>
      {latest && (
        <p class="checked">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect width="22" height="22" rx="11" fill="#1f5f4a"/><path d="M6.2 11.2 9.3 14.3 15.8 7.8" fill="none" stroke="#f3efe6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Prices checked <time datetime={latest}>{latestLabel}</time>
        </p>
      )}
      <p class="lead">An AI answering service uses software to pick up inbound calls. This page lists every AI receptionist in the directory. The order uses only the monthly dollar amount written in each published price, checked against the source on the vendor page.</p>
    </div>
  </header>
  <div class="wrap stack">
    <p>Compare by industry: <a href="/industries/dental/">dental practices</a>, <a href="/industries/legal/">law firms</a>, <a href="/industries/plumbing/">plumbing companies</a>, and <a href="/industries/medical/">medical practices</a>. Every published starting price is also on <a href="/pricing/">the pricing page</a>. Phone-recording statutes are on <a href="/call-recording-consent-by-state/">call recording consent by state</a>.</p>
    <section aria-labelledby="compare-heading">
      <h2 id="compare-heading" class="section-title">Comparison table</h2>
      <VendorTable vendors={vendors} caption={caption}/>
    </section>
    <Faq items={faqs}/>
  </div>
</Base>
