---
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';
import Checklist from '../../components/Checklist.astro';
import stories from '../../data/stories.json';
import { formatDate, industryHref, industryLabel } from '../../lib/stories.mjs';
export function getStaticPaths() {
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}
const { story } = Astro.props;
const primary = story.sources[0];
const description = story.whatTheyDid.slice(0, 220);
const url = new URL(`/stories/${story.slug}/`, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: story.title,
  url,
  description,
  citation: story.sources.map((source) => ({
    '@type': 'CreativeWork',
    name: source.title,
    url: source.url,
    datePublished: source.date,
  })),
};
---
<Base title={story.title} description={description} jsonld={jsonld}>
  <header class="page-intro">
    <div class="wrap">
      <p class="story-meta">
        <span class:list={['badge-source', story.evidence === 'vendor-told' ? 'badge-vendor' : 'badge-independent']}>
          {story.evidence === 'vendor-told' ? 'Vendor-told' : 'Independent'}
        </span>
        <a href="/stories/">All stories</a>
        <a href="/stories/#how-we-source">How we source stories</a>
      </p>
      <p class="told-by">{story.told_by}</p>
      <h1>{story.title}</h1>
      {primary && <p class="checked">Source dated <time datetime={primary.date}>{formatDate(primary.date)}</time></p>}
    </div>
  </header>
  <div class="wrap stack">
    <dl class="record">
      <div>
        <dt>Business</dt>
        <dd>{story.business || <span class="missing">Not stated</span>}</dd>
      </div>
      <div>
        <dt>Industry</dt>
        <dd>
          {(story.industries || []).map((id, index) => (
            <>
              {index ? ', ' : ''}
              {industryHref(id) ? <a href={industryHref(id)}>{industryLabel(id)}</a> : industryLabel(id)}
            </>
          ))}
        </dd>
      </div>
      <div>
        <dt>Vendor</dt>
        <dd>
          {story.vendorSlug
            ? <a href={`/vendors/${story.vendorSlug}/`}>{story.vendorName}</a>
            : (story.vendorName || <span class="missing">Not stated</span>)}
        </dd>
      </div>
      <div>
        <dt>Cost</dt>
        <dd>{story.cost || <span class="missing">Not stated</span>}</dd>
      </div>
    </dl>
    <p class="story-proof">
      {primary && <a href={primary.url} rel="nofollow noopener">{story.source_publisher}: {primary.title} (dated {formatDate(primary.date)})</a>}
      {story.archive_url && <> · <a href={story.archive_url} rel="noopener">Saved copy</a></>}
    </p>
    <p class="checked-line">What we checked: {story.verified_claims}</p>
    <section>
      <h2 class="section-title">What they did</h2>
      <p>{story.whatTheyDid}</p>
    </section>
    <section>
      <h2 class="section-title">What went wrong, or the catch</h2>
      {story.catches?.length
        ? story.catches.map((item) => <p>{item.summary}</p>)
        : <p class="missing">Not stated</p>}
    </section>
    <section>
      <h2 class="section-title">Outcome</h2>
      <p>{story.outcome}</p>
    </section>
    <Share url={url} title={story.title} />
    <Checklist catches={story.catches || []} />
    <section>
      <h2 class="section-title">Sources</h2>
      <ul class="sources">
        {story.sources.map((source) => (
          <li>
            <a href={source.url} rel="nofollow noopener">{source.publisher}: {source.title} (dated {formatDate(source.date)})</a>
            {source.archive_url && <> · <a href={source.archive_url} rel="noopener">Saved copy</a></>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
