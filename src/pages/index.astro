---
import Base from '../layouts/Base.astro';
import CallSlider from '../components/CallSlider.astro';
import IndustryIcon from '../components/IndustryIcon.astro';
import VendorMark from '../components/VendorMark.astro';
import AuditCta from '../components/AuditCta.astro';
import PricePlans from '../components/PricePlans.astro';
import { showAuditLinks } from '../lib/audit.mjs';
import data from '../data/vendors.json';
import stories from '../data/stories.json';
import priceLog from '../data/price-changes.json';
import { addedThisWeek, formatDate, latestByAdded, sourceDate, weekStart } from '../lib/stories.mjs';
import { priceChangeHeadline } from '../lib/price-changes.mjs';
import { getLandings } from '../lib/landings.mjs';
import { getBestGuides } from '../lib/best-guides.mjs';
const c = (k) => data.filter((v) => v.industries.includes(k)).length;
const industryLabel = { dental: 'Dental', legal: 'Legal', plumbing: 'Plumbing', medical: 'Medical' };
const checkedLabel = (iso) => iso
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`))
  : '';
const picks = [...data]
  .filter((v) => v.starting_price)
  .sort((a, b) => a.name.localeCompare(b.name))
  .slice(0, 5);
const industryText = (v) => (v.industries || []).map((k) => industryLabel[k] || k).filter(Boolean).join(', ');
const built = new Date().toISOString().slice(0, 10);
const freshStories = latestByAdded(stories, 4);
const freshPrices = latestByAdded(priceLog.changes.map((change) => ({ ...change, title: priceChangeHeadline(change) })), 2);
const latestItems = [...freshStories.map((story) => ({
  href: `/stories/${story.slug}/`,
  label: story.title,
  date: sourceDate(story),
  kind: 'Story',
})), ...freshPrices.map((change) => ({
  href: `/price-changes/${change.id}/`,
  label: change.title,
  date: change.observed,
  kind: 'Price change',
}))].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const start = weekStart(built);
const priceChangesWeek = priceLog.changes.filter((change) => change.observed >= start && change.observed <= built).length;
const lastUpdated = data.map((vendor) => vendor.last_checked).filter(Boolean).sort().at(-1) || built;
const guides = [...getBestGuides(), ...getLandings()];
const homeUrl = new URL('/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${homeUrl}#webpage`, name: 'Compare AI phone answering services for small businesses', url: homeUrl, isPartOf: { '@id': `${homeUrl}#website` }, dateModified: lastUpdated },
    { '@type': 'ItemList', name: 'AI receptionists', dateModified: lastUpdated, itemListElement: data.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: v.name, url: new URL(`/vendors/${v.slug}/`, Astro.site).href })) },
  ],
};
const shortDate = (iso) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
---
<Base title="Compare AI phone answering services, with real prices" description="A free, independent site that compares AI phone answering services for small businesses. See real monthly prices for your call volume, then pick one yourself or have us set it up. Rankings are not for sale." jsonld={jsonld}>
  <section class="hero hero-home">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Free · Independent · Real prices</p>
        <h1>Never miss a customer call. Find the right AI answering service.</h1>
        <p class="lead">A free, independent site that compares {data.length} AI phone answering services for small businesses, with real prices from each company's own website.</p>
        <ol class="how-steps" aria-label="How it works">
          <li><span>1</span>Tell us your business and how many calls you get</li>
          <li><span>2</span>See the services that fit, and what each really costs a month</li>
          <li><span>3</span>Pick one yourself, or <a href="/done-for-you/">have us set it up</a></li>
        </ol>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href="/match/">Find my best match <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-secondary btn-lg" href="/cost/calculator/">See what it costs</a>
        </div>
        <p class="tool-line">Free, no sign-up. Already paying for one? <a class="text-link" href="/overpaying/">See if you're overpaying</a>.</p>
      </div>
      <CallSlider />
    </div>
  </section>
  <section class="trust-band" aria-label="How we work">
    <div class="wrap">
      <ul class="trust-strip">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
          <div><strong>Independent</strong><span>No company can pay to rank higher. <a href="/about/">How this site works</a></span></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>
          <div><strong>Real prices</strong><span>Each price links to the company's own page. Last checked <time datetime={lastUpdated}>{shortDate(lastUpdated)}</time>.</span></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
          <div><strong>Ads are labeled</strong><span>Any paid spot always says Sponsored. <a href="/stories/#how-we-source">How we check</a></span></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/></svg>
          <div><strong>{data.length} services compared</strong><span>{stories.length} real stories · <a href="/price-changes/">{priceChangesWeek} price {priceChangesWeek === 1 ? 'change' : 'changes'} this week</a></span></div>
        </li>
      </ul>
    </div>
  </section>
  <section class="picks-band" aria-labelledby="top-picks-heading">
    <div class="wrap">
      <h2 class="section-title" id="top-picks-heading">Starting prices, straight from each company</h2>
      <p class="price-cards-caption" id="top-picks-caption">Not a ranking. The first five services, A to Z, that show a starting price on their website.</p>
      <ul class="price-cards picks" role="list" aria-labelledby="top-picks-caption">
        {picks.map((v) => (
          <li class="price-card">
            <div class="price-card-head">
              <VendorMark slug={v.slug} name={v.name} />
              <h3><a href={`/vendors/${v.slug}/`}>{v.name}</a></h3>
            </div>
            <PricePlans vendor={v} meta tags />
            <p class="price-card-more"><a href={`/vendors/${v.slug}/`}>See {v.name} details<span class="arrow" aria-hidden="true"> →</span></a></p>
          </li>
        ))}
      </ul>
      <p class="price-cards-more"><a class="btn btn-ghost" href="/vendors/">See all {data.length} services</a></p>
    </div>
  </section>
  <section class="band" id="how-this-works" aria-labelledby="money-heading">
    <div class="wrap">
      <h2 class="section-title" id="money-heading">How this site works, and how we make money</h2>
      <ul class="money-grid">
        <li><strong>Free for businesses.</strong> Comparing, the cost tools and the price check cost you nothing. No sign-up.</li>
        <li><strong>We may earn a referral fee.</strong> Some links pay us a fee if you sign up. Each one is marked, and it never changes the price you pay.</li>
        <li><strong>Companies can buy a labeled ad spot.</strong> It always says Sponsored, so you know it's an ad.</li>
        <li><strong>Rankings are not for sale.</strong> Lists are A to Z. Payment never changes a price, a fact or the order. If we can't confirm a fee, we say so.</li>
      </ul>
      <p class="money-more">We also offer a paid <a href="/done-for-you/">done-for-you setup</a> if you'd rather not do it yourself. <a href="/about/">More on how we work</a>.</p>
    </div>
  </section>
  <section class="band" aria-labelledby="fresh-heading">
    <div class="wrap">
      <h2 class="section-title" id="fresh-heading">Latest news and price changes</h2>
      <p class="lead">Built <time datetime={built}>{formatDate(built)}</time>. {addedThisWeek(stories, built).length + priceChangesWeek} new this week.</p>
      <ul class="ticker">
        {latestItems.map((item) => (
          <li>
            <span class="updated">{item.kind}</span>
            <a href={item.href}>{item.label}</a>
            {item.date && <time datetime={item.date}>{formatDate(item.date)}</time>}
          </li>
        ))}
      </ul>
      <p class="index-link"><a href="/price-changes/">See every logged price change</a>, grouped by week. <a href="/price-changes/feed.xml">Subscribe by RSS</a>.</p>
    </div>
  </section>
  <section class="band" aria-labelledby="guides-heading">
    <div class="wrap">
      <h2 class="section-title" id="guides-heading">Guides for your type of business</h2>
      <ul class="link-grid">
        {guides.map((page) => <li><a href={page.path}>{page.h1}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="band" id="industries">
    <div class="wrap">
      <h2 class="section-title">Browse by industry</h2>
      <div class="industries">
        <a class="industry reveal" data-industry="dental" href="/industries/dental/">
          <IndustryIcon name="dental" />
          <h3>Dental</h3>
          <p>{c('dental')} services · books into your dental software, patient privacy (HIPAA)</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry reveal" data-industry="legal" href="/industries/legal/">
          <IndustryIcon name="legal" />
          <h3>Law firms</h3>
          <p>{c('legal')} services · takes new-client details, works with Clio and MyCase</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry reveal" data-industry="plumbing" href="/industries/plumbing/">
          <IndustryIcon name="plumbing" />
          <h3>Home services</h3>
          <p>{c('plumbing')} services · sends urgent jobs to the right tech, works with ServiceTitan and Jobber</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry reveal" data-industry="medical" href="/industries/medical/">
          <IndustryIcon name="medical" />
          <h3>Medical</h3>
          <p>{c('medical')} services · books appointments, patient privacy (HIPAA)</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry" href="/pricing/">
          <h3>All pricing</h3>
          <p>Every published starting price</p>
          <span class="go">See pricing <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      </div>
    </div>
  </section>
  {showAuditLinks() && (
    <section class="band">
      <div class="wrap">
        <AuditCta heading="Wondering how easy it is for customers to reach you?" />
      </div>
    </section>
  )}
  <section class="band">
    <div class="wrap">
      <h2 class="section-title">Every service we compare</h2>
      <p style="margin: 0 0 18px; max-width: 66ch;">The <a href="/vendors/">full list</a> shows each one with its starting price and where we found it.</p>
      <ul class="directory">{data.map((v) => <li><VendorMark slug={v.slug} name={v.name} /><a href={`/vendors/${v.slug}/`}>{v.name}</a>{v.last_checked && <time class="updated" datetime={v.last_checked}>Price checked {formatDate(v.last_checked)}</time>}</li>)}</ul>
    </div>
  </section>
</Base>
