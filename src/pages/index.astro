---
import Base from '../layouts/Base.astro';
import CallSlider from '../components/CallSlider.astro';
import IndustryIcon from '../components/IndustryIcon.astro';
import VendorMark from '../components/VendorMark.astro';
import AuditCta from '../components/AuditCta.astro';
import { showAuditLinks } from '../lib/audit.mjs';
import data from '../data/vendors.json';
import stories from '../data/stories.json';
import priceLog from '../data/price-changes.json';
import { addedThisWeek, formatDate, latestByAdded, sourceDate, weekStart } from '../lib/stories.mjs';
import { getLandings } from '../lib/landings.mjs';
const c = (k) => data.filter((v) => v.industries.includes(k)).length;
const industryLabel = { dental: 'Dental', legal: 'Legal', plumbing: 'Plumbing', medical: 'Medical' };
const checkedLabel = (iso) => iso
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`))
  : '';
const picks = [...data]
  .filter((v) => v.starting_price)
  .sort((a, b) => a.name.localeCompare(b.name))
  .slice(0, 5);
const industryText = (v) => (v.industries || []).map((k) => industryLabel[k] || k).filter(Boolean).join(', ');
const built = new Date().toISOString().slice(0, 10);
const names = Object.fromEntries(data.map((vendor) => [vendor.slug, vendor.name]));
const freshStories = latestByAdded(stories, 4);
const freshPrices = latestByAdded(priceLog.changes.map((change) => ({ ...change, title: `${names[change.vendorSlug] || change.vendorSlug} price change` })), 2);
const latestItems = [...freshStories.map((story) => ({
  href: `/stories/${story.slug}/`,
  label: story.title,
  date: sourceDate(story),
  kind: 'Story',
})), ...freshPrices.map((change) => ({
  href: `/price-changes/${change.id}/`,
  label: change.title,
  date: change.observed,
  kind: 'Price change',
}))].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const start = weekStart(built);
const priceChangesWeek = priceLog.changes.filter((change) => change.observed >= start && change.observed <= built).length;
const lastUpdated = data.map((vendor) => vendor.last_checked).filter(Boolean).sort().at(-1) || built;
const guides = getLandings();
const homeUrl = new URL('/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${homeUrl}#webpage`, name: 'What an AI receptionist will cost', url: homeUrl, isPartOf: { '@id': `${homeUrl}#website` }, dateModified: lastUpdated },
    { '@type': 'ItemList', name: 'AI receptionists', dateModified: lastUpdated, itemListElement: data.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: v.name, url: new URL(`/vendors/${v.slug}/`, Astro.site).href })) },
  ],
};
const shortDate = (iso) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
---
<Base title="What an AI receptionist will cost" description="Match your call volume to official published plans, and see where a fee is still unknown. The directory keeps sourced starting prices. Sponsored spots are labeled; rankings are not for sale." jsonld={jsonld}>
  <section class="hero hero-home">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent · Every price sourced and dated</p>
        <h1>What an AI receptionist will cost</h1>
        <p class="lead">Compare {data.length} AI receptionists on published prices, then estimate the bill at your call volume wherever the plan is published. Sponsored spots are labeled, and rankings are not for sale.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href="/match/">Find my match <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-secondary btn-lg" href="/cost/calculator/">Estimate my cost</a>
        </div>
        <p class="tool-line">Already paying for one? <a class="text-link" href="/overpaying/">Check your price against published plans</a>. Free, no sign-up.</p>
      </div>
      <CallSlider />
    </div>
  </section>
  <section class="trust-band" aria-label="How we work">
    <div class="wrap">
      <ul class="trust-strip">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
          <div><strong>Independent</strong><span>Rankings are not for sale. <a href="/about/">How we rank</a></span></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>
          <div><strong>Sourced and dated</strong><span>Prices link to a source. Last checked <time datetime={lastUpdated}>{shortDate(lastUpdated)}</time>.</span></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
          <div><strong>Sponsors labeled</strong><span>Paid spots always say Sponsored. <a href="/stories/#how-we-source">How we verify</a></span></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/></svg>
          <div><strong>{data.length} vendors tracked</strong><span>{stories.length} real stories · {priceChangesWeek} price {priceChangesWeek === 1 ? 'change' : 'changes'} this week</span></div>
        </li>
      </ul>
    </div>
  </section>
  <section class="picks-band" aria-labelledby="top-picks-heading">
    <div class="wrap">
      <h2 class="section-title" id="top-picks-heading">Published starting prices</h2>
      <div class="tablewrap picks" tabindex="0" aria-labelledby="top-picks-caption">
        <table class="compare">
          <caption id="top-picks-caption">Not a ranking. The first five vendors, A to Z, that have a published starting price.</caption>
          <thead>
            <tr>
              <th scope="col">Vendor</th>
              <th scope="col">Starting price</th>
              <th scope="col">Checked</th>
              <th scope="col">Source</th>
              <th scope="col">Industry</th>
            </tr>
          </thead>
          <tbody>
            {picks.map((v) => (
              <tr>
                <th scope="row"><a href={`/vendors/${v.slug}/`}>{v.name}</a></th>
                <td data-label="Starting price">{v.starting_price || <span class="missing">Not verified</span>}</td>
                <td data-label="Checked">{v.last_checked ? <time datetime={v.last_checked}>{checkedLabel(v.last_checked)}</time> : <span class="missing">Not verified</span>}</td>
                <td data-label="Source">{v.sources?.[0] ? <a href={v.sources[0]} rel="nofollow noopener">Price source<span class="vh"> for {v.name}</span></a> : <span class="missing">Not verified</span>}</td>
                <td data-label="Industry">{industryText(v) || <span class="missing">Not verified</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <ul class="principles">
        <li><strong>Your volume.</strong> A starting price is not the bill at your call count. The cost tool separates the monthly scenario from one-time fees.</li>
        <li><strong>Official math only.</strong> That tool covers providers whose own pricing page publishes the unit, allowance, and overage. Everyone else stays in the directory.</li>
        <li><strong>Unknowns stay unknown.</strong> A missing fee is “not verified” or “cannot estimate.” Payment never changes the data or the order.</li>
      </ul>
    </div>
  </section>
  <section class="band" aria-labelledby="fresh-heading">
    <div class="wrap">
      <h2 class="section-title" id="fresh-heading">Latest</h2>
      <p class="lead">Built <time datetime={built}>{formatDate(built)}</time>. {addedThisWeek(stories, built).length + priceChangesWeek} new this week.</p>
      <ul class="ticker">
        {latestItems.map((item) => (
          <li>
            <span class="updated">{item.kind}</span>
            <a href={item.href}>{item.label}</a>
            {item.date && <time datetime={item.date}>{formatDate(item.date)}</time>}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="band" aria-labelledby="guides-heading">
    <div class="wrap">
      <h2 class="section-title" id="guides-heading">Questions the directory can answer</h2>
      <ul class="link-grid">
        {guides.map((page) => <li><a href={page.path}>{page.h1}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="band" id="industries">
    <div class="wrap">
      <h2 class="section-title">Browse by industry</h2>
      <div class="industries">
        <a class="industry reveal" data-industry="dental" href="/industries/dental/">
          <IndustryIcon name="dental" />
          <h3>Dental</h3>
          <p>{c('dental')} tools · PMS write-back, BAAs</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry reveal" data-industry="legal" href="/industries/legal/">
          <IndustryIcon name="legal" />
          <h3>Law firms</h3>
          <p>{c('legal')} tools · intake, Clio/MyCase</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry reveal" data-industry="plumbing" href="/industries/plumbing/">
          <IndustryIcon name="plumbing" />
          <h3>Home services</h3>
          <p>{c('plumbing')} tools · plumbing, HVAC routing, ServiceTitan/Jobber</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry reveal" data-industry="medical" href="/industries/medical/">
          <IndustryIcon name="medical" />
          <h3>Medical</h3>
          <p>{c('medical')} tools · scheduling, HIPAA BAA</p>
          <span class="go">Compare <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="industry" href="/pricing/">
          <h3>All pricing</h3>
          <p>Every published starting price</p>
          <span class="go">See pricing <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      </div>
    </div>
  </section>
  {showAuditLinks() && (
    <section class="band">
      <div class="wrap">
        <AuditCta heading="Wondering what happens when customers call after hours?" />
      </div>
    </section>
  )}
  <section class="band">
    <div class="wrap">
      <h2 class="section-title">All vendors</h2>
      <p style="margin: 0 0 18px; max-width: 66ch;">The <a href="/vendors/">vendor directory</a> lists every one, with the sourced starting price.</p>
      <ul class="directory">{data.map((v) => <li><VendorMark slug={v.slug} name={v.name} /><a href={`/vendors/${v.slug}/`}>{v.name}</a>{v.last_checked && <time class="updated" datetime={v.last_checked}>Price checked {formatDate(v.last_checked)}</time>}</li>)}</ul>
    </div>
  </section>
</Base>
