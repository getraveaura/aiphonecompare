---
import Base from '../layouts/Base.astro'; import data from '../data/vendors.json';
const c=k=>data.filter(v=>v.industries.includes(k)).length;
---
<Base title="Compare AI receptionists by industry" description="Compare 40 AI receptionists for dental, legal and plumbing businesses: pricing, HIPAA/BAA, human handoff and integrations, with sources." jsonld={{"@context":"https://schema.org","@type":"ItemList","name":"AI receptionists","itemListElement":data.map((v,i)=>({"@type":"ListItem","position":i+1,"name":v.name,"url":new URL(`vendors/${v.slug}/`,Astro.site+"/").href}))}}><h1>Compare AI receptionists by industry</h1>
<p class="lead">{data.length} AI receptionists and voice agents, with pricing, HIPAA/BAA status and integrations pulled from vendor sites and cited sources. Independent; sponsored spots are labeled.</p>
<div class="cards">
<a class="card" href="/industries/dental/"><h2>Dental</h2><p>{c('dental')} tools · PMS write-back, BAAs</p></a>
<a class="card" href="/industries/legal/"><h2>Law firms</h2><p>{c('legal')} tools · intake, Clio/MyCase</p></a>
<a class="card" href="/industries/plumbing/"><h2>Plumbing</h2><p>{c('plumbing')} tools · emergency routing, ServiceTitan/Jobber</p></a>
<a class="card" href="/pricing/"><h2>All pricing</h2><p>Every published starting price</p></a>
</div>
<h2>All vendors</h2><ul class="cards" style="list-style:none;padding:0">{data.map(v=><li><a href={`/vendors/${v.slug}/`}>{v.name}</a></li>)}</ul></Base>
