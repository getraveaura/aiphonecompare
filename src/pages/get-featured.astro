---
import Base from '../layouts/Base.astro';
---
<Base title="Get featured" description="Industry spotlight is $49 for 30 days: the top spot on one industry page, labeled Sponsored, with no contract.">
  <header class="page-intro featured-intro">
    <div class="wrap">
      <h1>Get your AI receptionist featured</h1>
      <p class="lead">Sponsored spots are clearly labeled. Rankings, listings, and verified prices are never for sale.</p>
    </div>
  </header>
  <div class="wrap stack featured-offers">
    <div class="offers">
      <article class="offer">
        <div class="offer-copy">
          <h2>Industry spotlight</h2>
          <p class="price">$49 <span>/ 30 days (early-bird)</span></p>
          <p>Available. Top spot on one industry page, labeled Sponsored. No contract.</p>
        </div>
        <div class="offer-foot">
          <a class="btn btn-primary" href="https://buy.stripe.com/dRmdR9aLVbiB7gY8s29ws00">Pay $49 for a 30-day industry spotlight</a>
        </div>
      </article>
      <article class="offer">
        <div class="offer-copy">
          <h2>Multi-industry</h2>
          <p class="price">$149</p>
          <p>Top of up to 3 industry pages plus badge.</p>
        </div>
        <div class="offer-foot">
          <p class="status">Coming soon</p>
        </div>
      </article>
      <article class="offer">
        <div class="offer-copy">
          <h2>Sitewide sponsor</h2>
          <p class="price">$299 <span>/ month</span></p>
          <p>Sitewide placement, labeled Sponsored.</p>
        </div>
        <div class="offer-foot">
          <p class="status">Coming soon</p>
        </div>
      </article>
    </div>
    <p class="after">After paying, email <a href="mailto:timothy@aiphonecompare.com?subject=Industry%20spotlight">timothy@aiphonecompare.com</a> with your company name and the industry you want.</p>
  </div>
</Base>
