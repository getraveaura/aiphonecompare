---
import Base from '../layouts/Base.astro';
---
<Base title="Get featured" description="Sponsorship options for AI receptionist vendors on aiphonecompare (preview, not yet available).">
  <header class="page-intro">
    <div class="wrap">
      <h1>Get your AI receptionist featured</h1>
    </div>
  </header>
  <div class="wrap stack">
    <p class="warn" role="note"><strong>Preview only:</strong> these tiers are placeholders. Nothing here is for sale yet and no payment links work.</p>
    <div class="offers">
      <article class="offer">
        <h2>Industry spotlight</h2>
        <p class="price">$49 <span style="font-family:var(--sans);font-size:1rem;letter-spacing:0">/ 30 days (placeholder)</span></p>
        <p>Top of one industry page, labeled Sponsored.</p>
        <button type="button" disabled aria-disabled="true">Not available yet</button>
      </article>
      <article class="offer">
        <h2>Multi-industry</h2>
        <p class="price">$149 <span style="font-family:var(--sans);font-size:1rem;letter-spacing:0">/ 30 days (placeholder)</span></p>
        <p>Top of up to 3 industry pages plus badge.</p>
        <button type="button" disabled aria-disabled="true">Not available yet</button>
      </article>
      <article class="offer">
        <h2>Sitewide sponsor</h2>
        <p class="price">$299 <span style="font-family:var(--sans);font-size:1rem;letter-spacing:0">/ month (placeholder, 3 spots)</span></p>
        <p>Sitewide placement, labeled Sponsored.</p>
        <button type="button" disabled aria-disabled="true">Not available yet</button>
      </article>
    </div>
    <p class="note">Sponsorship never changes listed prices, features or ordering within non-sponsored results.</p>
  </div>
</Base>
