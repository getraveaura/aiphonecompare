---
import Base from '../layouts/Base.astro';
import OfferProof from '../components/OfferProof.astro';
import OtherOffers from '../components/OtherOffers.astro';
import data from '../data/vendors.json';
import { SHOW_OFFER_PROOF, SPOTLIGHT } from '../lib/offers.mjs';
const pageUrl = new URL('/get-featured/', Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Industry spotlight',
  description: 'Top spot on one industry page for 30 days, labeled Sponsored. No contract. Early-bird price is $49.',
  image: new URL('/og/get-featured.png', Astro.site).href,
  brand: { '@type': 'Brand', 'name': 'aiphonecompare' },
  url: pageUrl,
  offers: {
    '@type': 'Offer',
    price: '49',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: pageUrl,
  },
};
const industries = [
  ['dental', 'Dental'],
  ['legal', 'Legal'],
  ['plumbing', 'Plumbing'],
  ['medical', 'Medical'],
].map(([key, label]) => ({ key, label, count: data.filter((v) => (v.industries || []).includes(key)).length }));
const faqs = [
  ['Who is this for?', 'Companies that sell an AI phone answering service (also called an AI receptionist) to small businesses.'],
  ['Does it change rankings or prices?', 'No. Lists are A to Z. Your ad shows first only on the one industry page you pick, with a Sponsored label. Payment never changes a price or the order of anyone else.'],
  ['Does it renew?', 'No. You pay once by card through Stripe, and the ad runs for 30 days. No contract.'],
  ['What if I change my mind?', 'Before it goes live: full refund, any time. In the first 7 days after it goes live: full refund if you are not happy, no questions asked. After day 7 there are no partial refunds and the spotlight runs its full 30 days.'],
  ['How do I start?', 'Pay below, then email timothy@aiphonecompare.com with your company name and the industry page you want.'],
  ['Can you remove an ad?', 'We may remove an ad that is misleading. If we do, we refund it in full.'],
];
---
<Base title="Get featured: the top spot on an industry page for $49" description="You sell an AI phone answering service. For $49, your company shows first on one industry page for 30 days, labeled Sponsored, in front of business owners who are comparing options. No contract." jsonld={jsonld} ogImage="/og/get-featured.png" dock={[[SPOTLIGHT.url, `Buy for $${SPOTLIGHT.price}`], ['#how-it-looks', 'See an example']]}>
  <header class="offer-hero">
    <div class="wrap">
      <p class="eyebrow">For companies that sell AI phone answering</p>
      <h1>Be the first company business owners see when they compare</h1>
      <p class="lead">Your company shows at the top of one industry page, like Dental or Legal, for 30 days. It's clearly labeled Sponsored, so buyers trust it.</p>
      <div class="cta">
        <a class="btn btn-primary btn-lg" href={SPOTLIGHT.url} data-offer-checkout="spotlight">Get featured for ${SPOTLIGHT.price} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-secondary btn-lg" href="#how-it-looks">See how it looks</a>
      </div>
      <ul class="offer-points">
        <li>{SPOTLIGHT.days} days</li>
        <li>No contract, no auto-renew</li>
        <li>Full refund in the first {SPOTLIGHT.refundDays} days</li>
      </ul>
      <p class="plain-example"><strong>Example:</strong> a dentist visits our Dental page to compare AI phone answering services. Your company is the first row they see, with your price and a short message from you. Everyone else stays in A to Z order.</p>
    </div>
  </header>

  <section class="offer-section" aria-labelledby="what-you-get">
    <div class="wrap offer-split">
      <div>
        <h2 id="what-you-get">What you get</h2>
        <ul class="feature-grid one">
          <li class="card"><span class="num">1</span><h3>The top row on one industry page</h3><p>Pick Dental, Legal, Plumbing or Medical. Your company shows first on that page for 30 days.</p></li>
          <li class="card"><span class="num">2</span><h3>Labeled, so buyers trust it</h3><p>It always says Sponsored. Your price and details stay exactly as we checked them.</p></li>
          <li class="card"><span class="num">3</span><h3>Simple to start</h3><p>Pay once, then email us your company name and the industry you want. No contract, and it does not renew.</p></li>
        </ul>
      </div>
      <aside class="card buy-box" id="buy" aria-labelledby="buy-heading">
        <h2 id="buy-heading" style="margin:0 0 .35rem; font-size: 1.35rem;">Industry spotlight (top spot)</h2>
        <p class="price-big">${SPOTLIGHT.price} <span>for {SPOTLIGHT.days} days (early price)</span></p>
        <ul>
          <li>Top spot on one industry page</li>
          <li>Labeled Sponsored</li>
          <li>Pay once, no contract</li>
          <li>Doesn't change rankings</li>
        </ul>
        <a class="btn btn-primary btn-lg btn-block" href={SPOTLIGHT.url} data-offer-checkout="spotlight">Pay $49 for a 30-day industry spotlight</a>
        <p class="assure"><strong>Full refund</strong> before it goes live, or in the first {SPOTLIGHT.refundDays} days after. <a href="/refunds/">Refund policy</a></p>
        <p class="note" style="margin-top:.85rem; font-size:.92rem;">After paying, email <a href="mailto:timothy@aiphonecompare.com?subject=Industry%20spotlight">timothy@aiphonecompare.com</a> with your company name and the industry you want.</p>
      </aside>
    </div>
  </section>

  <section class="offer-section" id="how-it-looks" aria-labelledby="how-heading">
    <div class="wrap">
      <h2 id="how-heading">How your ad looks</h2>
      <p class="lead" style="margin:-.35rem 0 1.25rem; font-size:1.05rem;">A picture of an industry page with your ad on top. The other companies stay in A to Z order.</p>
      <div class="card spot-preview" role="img" aria-label="Example: an industry table where the first row is labeled Sponsored and the other rows are in alphabetical order">
        <div class="spot-cap"><span>Example only</span><span>Dental page</span></div>
        <table aria-hidden="true">
          <tbody>
            <tr class="is-spot"><th class="spot-name">Your company <span class="badge">Sponsored</span><span class="spot-line">Your one-line message · Visit Your company</span></th><td>Your starting price</td></tr>
            <tr><th><span class="ghost" style="width:7rem"></span></th><td><span class="ghost" style="width:10rem"></span></td></tr>
            <tr><th><span class="ghost" style="width:9rem"></span></th><td><span class="ghost" style="width:8rem"></span></td></tr>
            <tr><th><span class="ghost" style="width:6rem"></span></th><td><span class="ghost" style="width:11rem"></span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="link-grid four" style="margin-top:16px;">
        {industries.map((i) => <a href={`/industries/${i.key}/`}>{i.label} page · {i.count} services listed</a>)}
      </div>
    </div>
  </section>

  <section class="offer-section" aria-labelledby="tiers-heading">
    <div class="wrap">
      <h2 id="tiers-heading">More ad options</h2>
      <div class="tier-row">
        <div class="card"><div><h3>Multi-industry · $149</h3><p>The top spot on up to 3 industry pages, plus a badge for your site.</p></div><span class="soon">Coming soon</span></div>
        <div class="card"><div><h3>Sitewide sponsor · $299 / month</h3><p>Your ad across the whole site, labeled Sponsored.</p></div><span class="soon">Coming soon</span></div>
      </div>
    </div>
  </section>

  {SHOW_OFFER_PROOF && <section class="offer-section">
    <div class="wrap">
      <OfferProof heading="Spotlight results" body="Spotlights are new. With each sponsor's permission, we'll share real results here once a spotlight has run. We won't post made-up quotes or numbers." />
    </div>
  </section>}

  <section class="offer-section" aria-labelledby="faq-heading">
    <div class="wrap" style="max-width: 820px;">
      <h2 id="faq-heading">Questions</h2>
      <div class="faq-list">
        {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <OtherOffers />

</Base>
