---
// Honest social-proof slot. Shows a placeholder until real, permissioned results exist.
const { heading = 'Results from early customers', body } = Astro.props;
---
<aside class="proof-slot" aria-label={heading}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
  <div>
    <h2>{heading}</h2>
    <p>{body}</p>
  </div>
</aside>
