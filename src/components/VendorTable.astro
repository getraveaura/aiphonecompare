---
import { sponsoredLabel } from '../lib/spotlight.mjs';
const { vendors, industry = '', caption = 'Blank means not verified. Open a vendor for sources and the date we checked.' } = Astro.props;
const spotlightLink = (v) => (/^https:\/\//.test(v.spotlight?.href || '') ? v.spotlight.href : '');
const cols = [
  ['starting_price', 'Starting price'],
  ['billing_model', 'Billing'],
  ['free_trial', 'Trial'],
  ['human_handoff', 'Human handoff'],
  ['hipaa_baa', 'HIPAA / BAA'],
  ['integrations', 'Integrations'],
];
---
<div class="tablewrap" tabindex="0" aria-labelledby="vendor-compare-caption">
  <table class="compare">
    <caption id="vendor-compare-caption">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Vendor</th>
        {cols.map(([, label]) => <th scope="col">{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {vendors.map((v) => (
        <tr>
          <th scope="row">
            <a href={`/vendors/${v.slug}/`}>{v.name}</a>
            {sponsoredLabel(v, industry) && <span class="badge">Sponsored</span>}
            {industry && sponsoredLabel(v, industry) && (v.spotlight.line || spotlightLink(v)) && (
              <span class="spotlight-line">{v.spotlight.line}{v.spotlight.line && spotlightLink(v) && ' '}{spotlightLink(v) && <a href={spotlightLink(v)} rel="sponsored noopener">Visit {v.name}</a>}</span>
            )}
          </th>
          {cols.map(([key, label]) => (
            <td data-label={label}>{v[key] || <span class="missing">Not verified</span>}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
