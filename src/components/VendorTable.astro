---
const { vendors } = Astro.props;
const cols = [
  ['starting_price', 'Starting price'],
  ['billing_model', 'Billing'],
  ['free_trial', 'Trial'],
  ['human_handoff', 'Human handoff'],
  ['hipaa_baa', 'HIPAA / BAA'],
  ['integrations', 'Integrations'],
];
---
<div class="tablewrap" tabindex="0" aria-labelledby="vendor-compare-caption">
  <table class="compare">
    <caption id="vendor-compare-caption">Blank means not verified. Open a vendor for sources and the date we checked.</caption>
    <thead>
      <tr>
        <th scope="col">Vendor</th>
        {cols.map(([, label]) => <th scope="col">{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {vendors.map((v) => (
        <tr>
          <th scope="row">
            <a href={`/vendors/${v.slug}/`}>{v.name}</a>
            {v.sponsored && <span class="badge">Sponsored</span>}
          </th>
          {cols.map(([key, label]) => (
            <td data-label={label}>{v[key] || <span class="missing">Not verified</span>}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
