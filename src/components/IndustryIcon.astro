---
const { name = 'other' } = Astro.props;
---
<svg class="i-icon" data-industry={name} width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'dental' && <path d="M7 11c1.4 3.2 8.6 3.2 10 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>}
  {name === 'legal' && <path d="M12 4v16M8 20h8M12 6 6.5 9.5h11L12 6ZM6.5 9.5 5 14h4l-2.5-4.5Zm11 0L15 14h4l-1.5-4.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>}
  {name === 'plumbing' && <path d="M8 7h5a3 3 0 0 1 0 6H9v4M9 13H7M14 7V4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>}
  {name === 'medical' && <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>}
  {name === 'hvac' && <path d="M12 4v16M4 12h16M6.5 6.5l11 11M17.5 6.5l-11 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>}
  {name === 'roofing' && <path d="M4 11 12 5l8 6v8H4v-8Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>}
  {name === 'med-spa' && <path d="M11 4.5l1.5 4 4 1.5-4 1.5-1.5 4-1.5-4-4-1.5 4-1.5 1.5-4ZM17.5 14.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>}
  {name === 'veterinary' && <path d="M8 9.5c0-1.4-1-2.5-2.2-2.5S3.6 8.1 3.6 9.5 5 12 6.2 12 8 10.9 8 9.5Zm5.8-2.2c0-1.5-1-2.7-2.3-2.7S9.2 5.8 9.2 7.3 10.2 10 11.5 10s2.3-1.2 2.3-2.7Zm7.6 2.2c0-1.4-1-2.5-2.2-2.5S16.4 8.1 16.4 9.5 17.8 12 19 12s2.2-1.1 2.2-2.5ZM16 9.5c0-1.5-1-2.7-2.3-2.7S11.4 8 11.4 9.5 12.4 12.2 13.7 12.2 16 11 16 9.5ZM8.5 14.5c1.2 2.8 5.8 2.8 7 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>}
  {name === 'chiro' && <path d="M12 3.5v17M9 7.5c0 2 1.3 3.2 3 3.2s3-1.2 3-3.2M9 16.5c0-2 1.3-3.2 3-3.2s3 1.2 3 3.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>}
  {name === 'property' && <path d="M5 19V9l7-5 7 5v10H5Zm5 0v-6h4v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>}
  {name === 'auto' && <path d="M5 15.5 6.5 10h11L19 15.5v3h-2.2v-1.2H7.2V18.5H5v-3Zm3.2-3.2h7.6M8 16.2h.01M16 16.2h.01" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>}
  {name === 'salon' && <path d="M8 5c2 3 2 6 0 9m8-9c-2 3-2 6 0 9M10.5 11.5h3M9 19h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>}
  {name === 'other' && <path d="M7 7h3v3H7V7Zm7 0h3v3h-3V7ZM7 14h3v3H7v-3Zm7 0h3v3h-3v-3Z" fill="currentColor"/>}
</svg>
