---
// Dated, plain-English answer with a number, placed right under the H1 so
// search snippets and AI assistants can quote the first sentence as is.
// Text comes from src/lib/quotable.mjs (counted from the data at build time).
import { boldParts } from '../lib/summary-points.mjs';
const { text = '', label = 'Quick answer' } = Astro.props;
---
{text && (
  <p class="quick-answer" data-quick-answer>
    <span class="quick-answer-label">{label}</span>
    <span class="quick-answer-text">{boldParts(text).map((part) => part.bold ? <strong>{part.text}</strong> : part.text)}</span>
  </p>
)}
