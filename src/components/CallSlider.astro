---
import models from '../data/cost-models.json';
import vendors from '../data/vendors.json';
import { estimateVendor, money } from '../lib/match.mjs';
const slugs = ['smith-ai', 'dialzara', 'agentzap', 'elevenlabs-ai-receptionist'];
const calls = 80;
const minutes = 3;
const rows = slugs.map((slug) => {
  const vendor = vendors.find((item) => item.slug === slug);
  const est = estimateVendor(vendor, models, { mode: 'calls', amount: calls, durationMinutes: minutes, budget: '' });
  return { slug, name: vendor.name, est };
});
function figure(est) {
  if (est.status === 'unknown' || est.cents == null) return 'Cannot estimate';
  const label = est.status === 'partial' ? 'Partial estimate' : 'Estimate';
  return `${label} ${money(est.cents)}`;
}
---
<div class="slider-card">
  <p class="slider-kicker">Scenario, not a quote</p>
  <label for="call-slider">Monthly calls <output id="call-count" for="call-slider">{calls}</output></label>
  <input id="call-slider" type="range" min="20" max="400" step="10" value={calls} aria-describedby="slider-note">
  <p id="slider-note" class="hint">Uses a {minutes}-minute average call for minute-priced plans. Per-call plans ignore length. <a href="/cost/">See the method</a>.</p>
  <ul class="est-list">
    {rows.map((row) => (
      <li data-slug={row.slug}>
        <a href={`/vendors/${row.slug}/`}>{row.name}</a>
        <p class="est-figure" data-figure>{figure(row.est)}</p>
        <p class="est-plan" data-plan>{row.est.planName ? `${row.est.planName} plan` : 'No published plan fits this volume'}</p>
      </li>
    ))}
  </ul>
</div>
<script>
  import models from '../data/cost-models.json';
  import vendors from '../data/vendors.json';
  import { estimateVendor, money } from '../lib/match.mjs';
  const slugs = ['smith-ai', 'dialzara', 'agentzap', 'elevenlabs-ai-receptionist'];
  const input = document.getElementById('call-slider');
  const count = document.getElementById('call-count');
  const minutes = 3;
  function figure(est) {
    if (est.status === 'unknown' || est.cents == null) return 'Cannot estimate';
    const label = est.status === 'partial' ? 'Partial estimate' : 'Estimate';
    return label + ' ' + money(est.cents);
  }
  function paint() {
    const calls = Number(input.value);
    count.textContent = String(calls);
    slugs.forEach((slug) => {
      const vendor = vendors.find((item) => item.slug === slug);
      const est = estimateVendor(vendor, models, { mode: 'calls', amount: calls, durationMinutes: minutes, budget: '' });
      const li = document.querySelector('[data-slug="' + slug + '"]');
      if (!li) return;
      li.querySelector('[data-figure]').textContent = figure(est);
      li.querySelector('[data-plan]').textContent = est.planName ? est.planName + ' plan' : 'No published plan fits this volume';
    });
  }
  input.addEventListener('input', paint);
</script>
