---
const industries = [
  ['dental', 'Dental'],
  ['medical', 'Medical'],
  ['legal', 'Legal'],
  ['plumbing', 'Plumbing'],
  ['hvac', 'HVAC'],
  ['roofing', 'Roofing'],
  ['other', 'Other'],
];
---
<section class="guide" aria-labelledby="signup-heading">
  <h2 id="signup-heading">Get new stories and price changes</h2>
  <p>Pick an industry. We email when a story or a logged price change for that industry is added. No account. The address is stored only for that list.</p>
  <form id="story-signup" class="calc-form">
    <div>
      <label for="signup-email">Email</label>
      <input id="signup-email" name="email" type="email" autocomplete="email" required maxlength="320">
    </div>
    <div>
      <label for="signup-industry">Industry</label>
      <select id="signup-industry" name="industry" required>
        <option value="">Choose an industry</option>
        {industries.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <div class="vh" aria-hidden="true">
      <label for="signup-company-website">Company website</label>
      <input id="signup-company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
    </div>
    <button class="btn btn-primary" type="submit" id="signup-submit">Join the list</button>
    <p id="signup-status" class="note" role="status" aria-live="polite"></p>
  </form>
  <p class="note">We store the email and the industry in a database table the public can't read, and send a confirmation from timothy@aiphonecompare.com. To leave the list, reply to any email. Details are in the <a href="/privacy/">privacy policy</a>.</p>
  <noscript>
    <p>This form needs JavaScript. Email <a href="mailto:timothy@aiphonecompare.com?subject=Stories%20list">timothy@aiphonecompare.com</a> with your industry instead.</p>
  </noscript>
</section>
<script>
  import { LEAD_ENDPOINT, buildStoriesPayload, storiesSignupMessage } from '../lib/leads.mjs';
  import { track } from '../lib/analytics.mjs';

  const form = document.getElementById('story-signup') as HTMLFormElement | null;
  const status = document.getElementById('signup-status');
  const button = document.getElementById('signup-submit') as HTMLButtonElement | null;
  if (form && status && button) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const payload = buildStoriesPayload({
        email: data.get('email'),
        industry: data.get('industry'),
        honeypot: data.get('company_website'),
      });
      button.disabled = true;
      status.textContent = 'Sending…';
      let code = 0;
      let ok = false;
      try {
        const response = await fetch(LEAD_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        code = response.status;
        const body = await response.json().catch(() => null);
        ok = response.ok && body?.ok === true;
      } catch {
        code = 0;
      }
      button.disabled = false;
      status.textContent = storiesSignupMessage(code, ok);
      if (ok) {
        form.reset();
        track('stories_signup_submitted', { industry: payload.industry });
      }
    });
  }
</script>
