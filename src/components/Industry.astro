---
import Base from '../layouts/Base.astro';
import IndustryIcon from './IndustryIcon.astro';
import VerifyStrip from './VerifyStrip.astro';
import VendorTable from './VendorTable.astro';
import Faq from './Faq.astro';
import StoryCards from './StoryCards.astro';
import Catches from './Catches.astro';
import AnswerSummary from './AnswerSummary.astro';
import AuditCta from './AuditCta.astro';
import { industrySummary, sourceLinks, articleNode, breadcrumbNode } from '../lib/answers.mjs';
import data from '../data/vendors.json';
import stories from '../data/stories.json';
import { catchGroups, industryLabel, storiesForIndustry } from '../lib/stories.mjs';
import { accent } from '../lib/industries.mjs';
import { linkForIndustry } from '../lib/landings.mjs';
import { lowestMonthly, lowestMonthlyListing } from '../lib/price.mjs';
import { orderForIndustry } from '../lib/spotlight.mjs';
import { dfyForIndustryPage, dfyIndustryPath } from '../lib/dfy-industries.mjs';
import { DFY_OFFERS, usd } from '../lib/offers.mjs';
const { key, title, guide, faqs = [], guideTitle = 'What to check before you buy', note = '' } = Astro.props;
const vendors = orderForIndustry(data, key);
const money = (n) => (Number.isInteger(n) ? `$${n}` : `$${n}`);
const low = lowestMonthlyListing(vendors);
const lowAmount = low ? lowestMonthly(low.starting_price) : null;
const lowChecked = low?.last_checked
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${low.last_checked}T00:00:00Z`))
  : '';
const latest = vendors.map((v) => v.last_checked).filter(Boolean).sort().at(-1) || '';
const latestLabel = latest
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${latest}T00:00:00Z`))
  : '';
const priceSentence = lowAmount == null
  ? 'None of these listings has a monthly dollar amount in the starting price.'
  : `The lowest monthly amount written in these listings is ${money(lowAmount)}/mo, for ${low.name}${lowChecked ? `, checked ${lowChecked}` : ''}.`;
const allFaqs = [
  { q: 'What is the lowest published monthly price on this page?', a: `${priceSentence} Per-minute rates are not turned into a monthly price. Not verified means no monthly amount was published.` },
  { q: 'Are these tools ranked?', a: 'No. Rows are alphabetical. A sponsored listing is labeled and can appear first only on the one industry page it paid for. Payment does not change a price or the order of the other rows.' },
  ...faqs,
];
const relatedStories = storiesForIndustry(stories, key);
const costGuide = linkForIndustry(key);
const catchSet = catchGroups(stories, { industry: key });
const industries = [
  ['dental', 'Dental', '/industries/dental/'],
  ['legal', 'Legal', '/industries/legal/'],
  ['plumbing', 'Plumbing', '/industries/plumbing/'],
  ['medical', 'Medical', '/industries/medical/'],
].filter(([id]) => id !== key);
const dfy = dfyForIndustryPage(key);
const summary = industrySummary({ key, vendors, priceSentence });
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const site = new URL('/', Astro.site).href;
const pageTitle = `${title}: pricing compared${latest ? ` (${latest.slice(0, 4)})` : ''}`;
const summarySources = [{ href: '/price-index/', label: 'aiphonecompare price index' }, ...(low ? sourceLinks(low.sources, 1).map((s) => ({ ...s, label: `${low.name}: ${s.label}` })) : [])];
const metaDescription = `${summary[0]} HIPAA/BAA, human handoff and integrations are compared with sources.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({ url: pageUrl, headline: pageTitle, description: metaDescription, modified: latest, citations: vendors.map((v) => (v.sources || [])[0]).filter(Boolean), site }),
    breadcrumbNode([['Home', site], [title, pageUrl]]),
    { '@type': 'WebPage', name: title, url: new URL(Astro.url.pathname, Astro.site).href, isPartOf: { '@id': new URL('/#website', Astro.site).href }, ...(latest ? { dateModified: latest } : {}) },
    { '@type': 'ItemList', name: title, ...(latest ? { dateModified: latest } : {}), itemListElement: vendors.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: v.name, url: new URL(`/vendors/${v.slug}/`, Astro.site).href })) },
    { '@type': 'FAQPage', mainEntity: allFaqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  ],
};
---
<Base title={pageTitle} description={metaDescription} jsonld={jsonld} modified={latest}>
  <header class="page-intro" data-industry={key} style={`--accent:${accent(key)}`}>
    <div class="wrap">
      <VerifyStrip />
      <p class="industry-kicker"><IndustryIcon name={key} />{industryLabel(key)}</p>
      <h1>{title}</h1>
      <AnswerSummary sentences={summary} verified={latest} sources={summarySources} />
      <p class="lead">Sponsored listings are labeled. <a href="/cost/">See what a call volume costs</a> where a provider publishes allowances and overage rates. <a href={`/cost/calculator/?industry=${key}&calls=150&minutes=3`}>Open the calculator</a>.{costGuide && <> <a href={costGuide.href}>{costGuide.label}</a>.</>}</p>
    </div>
  </header>
  <div class="wrap stack">
    <p>
      Other industries:
      {industries.map(([id, label, href], i) => <>{i ? ', ' : ''}<a href={href}>{label}</a></>)}.
      All published starting prices are on <a href="/pricing/">pricing</a>.
      Call recording rules are on <a href="/call-recording-consent-by-state/">call recording consent by state</a>.
      <a href={`/match/?industry=${key}`}>Match a tool to a call volume</a>.
    </p>
    <section class="guide" aria-label={guideTitle}>
      <h2>{guideTitle}</h2>
      <ul>{guide.map((g) => <li set:html={g}/>)}</ul>
      {note && <p set:html={note}/>}
    </section>
    <section>
      <h2 class="section-title">Comparison table</h2>
      <VendorTable vendors={vendors} industry={key}/>
    </section>
    {relatedStories.length > 0 && (
      <section aria-labelledby="real-stories">
        <h2 id="real-stories" class="section-title">Real stories</h2>
        <p><a href="/stories/">All stories</a></p>
        <StoryCards stories={relatedStories} />
      </section>
    )}
    <Catches groups={catchSet} />
    {dfy && (
      <aside class="dfy-callout" data-industry={dfy.accent} style={`--accent:${accent(dfy.accent)}`} aria-labelledby="dfy-callout-heading">
        <IndustryIcon name={dfy.icon} />
        <div class="dfy-callout-copy">
          <p class="dfy-callout-kicker">Done-for-you setup · from {usd(DFY_OFFERS.founding.price)} one-time</p>
          <h2 id="dfy-callout-heading">Rather have it set up for you?</h2>
          <p>We pick, set up and tune an AI receptionist built for {dfy.audience}: {dfy.cardLine.toLowerCase()}. A defined result by day 60, or a full refund of our fee.</p>
        </div>
        <a class="btn btn-ghost" href={dfyIndustryPath(dfy.slug)}>See the {dfy.name.toLowerCase()} setup <span class="arrow" aria-hidden="true">→</span></a>
      </aside>
    )}
    <Faq items={allFaqs}/>
    <AuditCta />
  </div>
</Base>
