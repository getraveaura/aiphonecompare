---
import Base from '../layouts/Base.astro';
import VendorTable from './VendorTable.astro';
import data from '../data/vendors.json';
const { key, title, guide } = Astro.props;
const vendors = data.filter((v) => v.industries.includes(key)).sort((a, b) => (b.sponsored - a.sponsored) || a.name.localeCompare(b.name));
---
<Base title={title} description={`${title}: ${vendors.length} tools compared on price, HIPAA/BAA, human handoff and integrations, with sources.`} jsonld={{"@context":"https://schema.org","@type":"ItemList","name":title,"itemListElement":vendors.map((v,i)=>({"@type":"ListItem","position":i+1,"name":v.name,"url":new URL(`/vendors/${v.slug}/`,Astro.site).href}))}}>
  <header class="page-intro">
    <div class="wrap">
      <h1>{title}</h1>
      <p class="lead">{vendors.length} AI receptionists compared. Listed alphabetically; sponsored listings are labeled. <a href="/cost/">See what a call volume costs</a> for the providers with official allowances and overage rates.</p>
    </div>
  </header>
  <div class="wrap stack">
    <section class="guide" aria-label="Buying guide">
      <h2>What to check before you buy</h2>
      <ul>{guide.map((g) => <li set:html={g}/>)}</ul>
    </section>
    <section>
      <h2 class="section-title">Comparison table</h2>
      <VendorTable vendors={vendors}/>
    </section>
  </div>
</Base>
