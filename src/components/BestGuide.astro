---
import PlainIntro from './PlainIntro.astro';
import Base from '../layouts/Base.astro';
import IndustryIcon from './IndustryIcon.astro';
import VerifyStrip from './VerifyStrip.astro';
import VendorTable from './VendorTable.astro';
import Faq from './Faq.astro';
import QuickAnswer from './QuickAnswer.astro';
import KeyFindings from './KeyFindings.astro';
import SetupNextStep from './SetupNextStep.astro';
import AuditCta from './AuditCta.astro';
import NextSteps from './NextSteps.astro';
import { articleNode, breadcrumbNode, sourceLinks } from '../lib/answers.mjs';
import { industryLabel } from '../lib/stories.mjs';
import { accent } from '../lib/industries.mjs';
import { REFERRAL_NOTE } from '../lib/outbound.mjs';
import { dfyIndustry } from '../lib/dfy-industries.mjs';
import { getBestGuides } from '../lib/best-guides.mjs';
import { lowestMonthlyListing } from '../lib/price.mjs';
const { page } = Astro.props;
const dfy = dfyIndustry(page.dfySlug);
const label = (page.kicker || industryLabel(page.industryKey)).toLowerCase();
const otherGuides = getBestGuides().filter((g) => g.path !== page.path).map((g) => ({ href: g.path, label: g.kicker || industryLabel(g.industryKey) }));
const thirdCard = page.industryPath
  ? { href: page.industryPath, title: `Full ${industryLabel(page.industryKey).toLowerCase()} directory`, text: 'Every listing, with privacy and handoff' }
  : page.costPath ? { href: page.costPath, title: 'Cost at 50, 150 and 300 calls', text: 'Examples from published prices' } : null;
const latest = page.verified || '';
const pageUrl = new URL(page.path, Astro.site).href;
const site = new URL('/', Astro.site).href;
const low = lowestMonthlyListing(page.vendors) || page.vendors.find((v) => v.starting_price);
const summarySources = [
  { href: '/price-index/', label: 'aiphonecompare price index' },
  ...(low ? sourceLinks(low.sources, 1).map((s) => ({ ...s, label: `${low.name}: ${s.label}` })) : []),
];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    articleNode({ url: pageUrl, headline: page.title, description: page.description, modified: latest, citations: page.vendors.map((v) => (v.sources || [])[0]).filter(Boolean), site }),
    breadcrumbNode([['Home', site], ['Industry guides', new URL('/best/', Astro.site).href], [page.h1, pageUrl]]),
    { '@type': 'WebPage', name: page.h1, url: pageUrl, isPartOf: { '@id': new URL('/#website', Astro.site).href }, ...(latest ? { dateModified: latest } : {}) },
    { '@type': 'ItemList', name: page.h1, ...(latest ? { dateModified: latest } : {}), itemListElement: page.vendors.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: v.name, url: new URL(`/vendors/${v.slug}/`, Astro.site).href })) },
    { '@type': 'FAQPage', mainEntity: page.faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  ],
};
---
<Base title={page.title} description={page.description} jsonld={jsonld} modified={latest}>
  <header class="page-intro" data-industry={page.industryKey} style={`--accent:${accent(page.accent || page.industryKey)}`}>
    <div class="wrap">
      <VerifyStrip />
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/best/">Industry guides</a></li>
          <li><span aria-current="page">{page.h1}</span></li>
        </ol>
      </nav>
      <p class="industry-kicker"><IndustryIcon name={page.accent || page.industryKey} />{page.kicker || industryLabel(page.industryKey)}</p>
      <h1>{page.h1}</h1>
      <QuickAnswer text={page.answer} />
      <PlainIntro text={`A plain-English guide to choosing an AI phone answering service for ${(page.kicker || industryLabel(page.industryKey)).toLowerCase()}: who is listed, what it costs and what to test before you buy.`} />
      <KeyFindings findings={page.keyFindings} verified={latest} sources={summarySources} cite={page.cite} note="Not a ranking: rows are A to Z." />
      <NextSteps
        cards={[
          { href: page.industryKey ? `/match/?industry=${page.industryKey}` : '/match/', title: 'Find my best match', text: 'Pick your call volume and must-haves' },
          { href: page.calculatorPath, title: 'See my monthly cost', text: 'Estimate a bill from published prices' },
          thirdCard,
        ]}
        others={otherGuides}
      />
      {page.referralNote && <p class="note referral-note">{REFERRAL_NOTE}</p>}
    </div>
  </header>
  <div class="wrap stack">
    <section class="guide" aria-labelledby="look-for-heading">
      <h2 id="look-for-heading">What to look for in an AI receptionist for {page.audience}</h2>
      <ul>
        {page.checks.map((item) => (
          <li><strong>{item.h}:</strong> {item.p}</li>
        ))}
      </ul>
      <p class="good-to-know"><strong>Good to know:</strong> {page.scope}{page.costPath && page.industryPath && <> <a href={page.costPath}>Cost at 50, 150 and 300 calls</a>.</>} Call recording rules by state are on the <a href="/call-recording-consent-by-state/">call recording consent</a> page (not legal advice).</p>
    </section>
    {page.demoQuestions?.length > 0 && (
      <section class="guide guide-demo" aria-labelledby="demo-heading">
        <h2 id="demo-heading">5 questions to ask in every demo</h2>
        <p>Call each service on your shortlist and ask these. The answers show quickly which one fits {page.audience}.</p>
        <ol>
          {page.demoQuestions.map((q) => <li>{q}</li>)}
        </ol>
      </section>
    )}
    {page.vendors.length > 0 ? (
      <section>
        <h2 class="section-title">Sourced starting prices</h2>
        <p>Blank means not verified. Open a vendor for sources and the date we checked. Visit links for referral partners are labeled and use <code>rel="sponsored"</code>. They never change the order or a price.</p>
        <VendorTable vendors={page.vendors} industry={page.industryKey} />
      </section>
    ) : (
      <section>
        <h2 class="section-title">Sourced starting prices</h2>
        <p>There is no price table on this page. This site has no sourced vendor listing for this industry yet, and we do not borrow a list from another industry to fill the gap.</p>
      </section>
    )}
    <nav aria-label="Related" class="guide-related">
      <h2 class="section-title">More for {label}</h2>
      <ul class="link-grid">
        {page.related.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    {page.demoQuestions?.length > 0 && (
      <section class="guide guide-next" aria-labelledby="next-heading">
        <h2 id="next-heading">Your next steps</h2>
        <ol>
          <li><strong>Shortlist 2 or 3</strong> from the price table above. Start with the ones that offer a free trial.</li>
          <li><strong>Run the 5 demo questions</strong> on a real test call with each one.</li>
          <li><strong>Check your monthly bill</strong> with your own call volume in the <a href={page.calculatorPath}>cost calculator</a>.</li>
          <li><strong>Short on time?</strong> We can pick, set up and tune one for you, below.</li>
        </ol>
      </section>
    )}
    <SetupNextStep
      source={`best_${page.slug}`}
      href={page.dfyPath}
      audience={dfy ? dfy.audience : page.audience}
      title={page.demoQuestions?.length ? 'Rather have us set it up for you?' : 'Want us to set this up for you?'}
    />
    <Faq items={page.faqs} />
    <AuditCta />
  </div>
</Base>
