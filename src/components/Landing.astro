---
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import AnswerSummary from './AnswerSummary.astro';
import { articleNode } from '../lib/answers.mjs';
import { REFERRAL_NOTE } from '../lib/outbound.mjs';
const { page } = Astro.props;
const url = new URL(page.path, Astro.site).href;
const graph = [
  {
    '@type': 'WebPage',
    name: page.h1,
    description: page.description,
    url,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: page.crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, Astro.site).href,
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
for (const block of page.blocks) {
  if (block.type !== 'table') continue;
  graph.push({
    '@type': 'ItemList',
    name: block.caption,
    itemListElement: block.rows.map((row, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: row.map((item) => item.text).join(' · '),
      url: row.map((item) => item.href).find((href) => href && href.startsWith('/'))
        ? new URL(row.find((item) => item.href && item.href.startsWith('/')).href, Astro.site).href
        : url,
    })),
  });
}
const summaryText = (page.summary || []).join(' ');
const notes = page.answer.filter((p) => !summaryText.includes(p.replace(' That is the math on the published cards, not a ranking.', '')) && !(page.kind === 'compare' && /'s recorded starting price is /.test(p)));
const verifiedDates = (Array.isArray(page.verified) ? page.verified.map((d) => d.date) : [page.verified]).filter(Boolean).sort();
const modified = verifiedDates.at(-1) || page.date || '';
graph.push(articleNode({
  url,
  headline: page.title,
  description: page.description,
  modified,
  published: page.kind === 'fees' || page.kind === 'worth' ? page.date : '',
  citations: (page.sources || []).map((s) => s.href),
  site: Astro.site.href,
}));
---
<Base title={page.title} description={page.description} jsonld={{ '@context': 'https://schema.org', '@graph': graph }} modified={modified}>
  <header class="page-intro">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {page.crumbs.map((crumb, index) => (
            <li>
              {index < page.crumbs.length - 1
                ? <a href={crumb.href}>{crumb.name}</a>
                : <span aria-current="page">{crumb.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
      <h1>{page.h1}</h1>
      <AnswerSummary sentences={page.summary} verified={page.verified} sources={page.sources} />
      <div class="landing-notes">
        {notes.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      {page.referrals?.length > 0 && <p class="note referral-note">{REFERRAL_NOTE}</p>}
    </div>
  </header>
  <div class="wrap stack">
    {page.blocks.map((block) => block.type === 'table' ? (
      <div class="tablewrap" tabindex="0">
        <table class="compare">
          <caption>{block.caption}</caption>
          <thead>
            <tr>{block.headers.map((header) => <th scope="col">{header}</th>)}</tr>
          </thead>
          <tbody>
            {block.rows.map((row) => (
              <tr>
                {row.map((item, index) => {
                  const Tag = index === 0 ? 'th' : 'td';
                  const rel = item.rel || (item.external ? 'nofollow noopener' : undefined);
                  const visit = item.visit;
                  const visitIsPrimary = visit && item.href === visit.href;
                  return (
                    <Tag scope={index === 0 ? 'row' : undefined} data-label={block.headers[index]}>
                      {item.href && !visitIsPrimary
                        ? <a href={item.href} rel={visit ? undefined : rel}>{item.text}</a>
                        : item.datetime ? <time datetime={item.datetime}>{item.text}</time>
                        : !visitIsPrimary ? item.text
                        : null}
                      {visit && (
                        <>
                          {item.href && !visitIsPrimary && ' '}
                          <a href={visit.href} rel={visit.rel} data-vendor-slug={visit.slug} data-vendor-referral={visit.isReferral ? '1' : '0'}>{visitIsPrimary ? item.text : `Visit ${visit.name}`}</a>
                        </>
                      )}
                    </Tag>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <section>
        <h2 class="section-title">{block.heading}</h2>
        <ul>
          {block.items.map((item) => (
            <li>{item.href ? <a href={item.href} rel={item.external ? 'nofollow noopener' : undefined}>{item.text}</a> : item.text}</li>
          ))}
        </ul>
      </section>
    ))}
    <nav aria-label="Related">
      <h2 class="section-title">Related</h2>
      <ul>
        {page.related.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <Faq items={page.faqs} />
  </div>
</Base>
